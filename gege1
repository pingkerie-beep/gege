local function farmBoxHits(n,x,y)
    if n.boxHits then
        local hit=n.boxHits(x,y)
        assert(type(hit)=="boolean","Native avatar collision returned an invalid value.")
        return hit
    end
    -- Match the game's body bounds and half-open right/bottom edges exactly.
    for ty=math.floor(y-.95),math.floor(y-.0001) do
        for tx=math.floor(x-.3),math.floor(x+.3-.0001) do
            if n.solid(tx,ty) then return true end
        end
    end
    return false
end
-- BEGIN PNB SUPPORTED ROUTE
-- Shared clearance rules for planning and actual travel. One-way platforms
-- allow upward passage, but a downward route must leave their full footprint.
local function farmClearFlightSegment(n,ax,ay,bx,by,checkpoint)
    local grid=n.b and rawget(n.b.state,"fg")
    local db=n.b and n.b.itemDB
    if type(grid)~="table" or type(db)~="table" then return false,"grid" end
    if by>ay+.00001 then
        for row=math.max(0,math.floor(ay)),math.min(n.height-1,math.ceil(by)) do
            if checkpoint and checkpoint()==false then return false,"budget" end
            local plane=row
            if ay<=plane+.001 and by>plane+.00001 then
                local ratio=math.clamp((plane-ay)/(by-ay),0,1)
                local x=ax+(bx-ax)*ratio
                local cells=rawget(grid,row)
                for column=math.floor(x-.3),math.floor(x+.3-.0001) do
                    local id=type(cells)=="table" and rawget(cells,column)
                    local def=id and rawget(db,id)
                    if type(def)=="table" and rawget(def,"platform")==true then return false,"platform" end
                end
            end
        end
    end
    local distance=math.sqrt((bx-ax)^2+(by-ay)^2)
    local steps=math.max(1,math.ceil(distance/.1))
    for i=0,steps do
        if checkpoint and i%8==0 and checkpoint()==false then return false,"budget" end
        local ratio=i/steps
        local x,y=ax+(bx-ax)*ratio,ay+(by-ay)*ratio
        if x<.3 or x>n.width-.3 or y< -4 or y>=n.height then return false,"bounds" end
        if farmBoxHits(n,x,y) then return false,"solid" end
    end
    return true
end
local function farmFlightPath(n,ax,ay,bx,by,checkpoint,barriers)
    local grid=n.b and rawget(n.b.state,"fg")
    local db=n.b and n.b.itemDB
    -- A wall spanning the whole world has no exterior exit. For downward
    -- travel, a complete one-way floor also blocks every possible column.
    for row=math.max(0,math.floor(math.min(ay,by))),math.min(n.height-1,math.floor(math.max(ay,by))) do
        local cells=type(grid)=="table" and rawget(grid,row)
        local cacheKey=(by>ay and "down:" or "up:")..row
        local known=barriers and barriers[cacheKey]
        if known==true then return nil,"blocked" end
        if known==nil then
            local function barrier(column)
                local id=type(cells)=="table" and rawget(cells,column)
                local def=id and type(db)=="table" and rawget(db,id)
                if type(def)~="table" then return false end
                if by>ay and rawget(def,"platform")==true then return true end
                return rawget(def,"solid")==true and farmBoxHits(n,column+.5,row+.999)
            end
            local sealed=barrier(0) and barrier(n.width-1)
            if sealed then
                for column=1,n.width-2 do
                    if checkpoint and checkpoint()==false then return nil,"budget" end
                    if not barrier(column) then sealed=false;break end
                end
            end
            if barriers then barriers[cacheKey]=sealed end
            if sealed then return nil,"blocked" end
        end
