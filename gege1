            if data[key]~=nil and type(data[key])~="boolean" then return nil,"Startup settings must be on or off." end
        end
        if data.targetWorld~=nil and type(data.targetWorld)~="string" then return nil,"Invalid Target World." end
        local targetWorld=data.targetWorld or ""
        if targetWorld:match("^%s*$") then targetWorld=""
        else
            targetWorld=worldStartup.destination(targetWorld)
            if not targetWorld then return nil,"Use WORLD or WORLD:ID for Target World, for example KEWELYS:AWS." end
        end
        local worldLink=normalizeWorldLink(data.worldLink)
        if not worldLink then return nil,"Enter a world name such as CERELO for World Link, or leave it blank." end
        if data.autoJoinWorld==true and targetWorld=="" and worldLink=="" then
            return nil,"Enter a Target World or World Link before saving Auto Join World."
        end
        if not integer(data.hits) or data.hits<1 or data.hits>50 then return nil,"Hits per Block must be a whole number from 1 to 50." end
