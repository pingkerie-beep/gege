                    for _,drop in next,drops do
                        if worldDrop(n.b,drop) and math.floor(drop.x)==tx and math.floor(drop.y)==ty then
                            allowed=false;break
                        end
                    end
                end
                if allowed then return {x=x,y=y,sx=sx,sy=sy,tx=tx,ty=ty} end
            end
        end
    end
