        end
        if math.abs(x-transfer.x)>.00001 or math.abs(y-transfer.y)>.00001 then
            if not clearSegment(x,y,transfer.x,transfer.y) then failed("gravity correction meets a block");return end
            local moved,why=farmWritePosition(n,transfer.x,transfer.y,true)
            if not moved then halt(why);return end
        end
        local point=transfer.points[transfer.index]
        if not point then
            m.x,m.y=transfer.x,transfer.y;m.transfer=nil;m.supportStep={at=os.clock()};return
        end
        local dx,dy=point.x-transfer.x,point.y-transfer.y
        local distance=math.sqrt(dx*dx+dy*dy)
        if distance<=.00001 then transfer.index+=1;return end
        local stride=math.min(distance,math.min(f.speed or CONFIG.speed,CONFIG.speed)*math.max(0,math.min(dt,elapsed,CONFIG.frameLimit)))
        if stride<=0 then return end
        local nx,ny=transfer.x+dx/distance*stride,transfer.y+dy/distance*stride
        if not clearSegment(transfer.x,transfer.y,nx,ny) then failed("edge transfer path changed");return end
        local moved,why=farmWritePosition(n,nx,ny,true)
        if not moved then halt(why);return end
        transfer.x,transfer.y=nx,ny;m.x,m.y=nx,ny
        if (nx-transfer.progressX)^2+(ny-transfer.progressY)^2>=.01 then
            transfer.progressX,transfer.progressY=nx,ny;transfer.progressAt=os.clock()
        end
