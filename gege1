                local failures=f.motionEdges.failures or {};f.motionEdges.failures=failures
                local previous=failures[corridor]
                local count=previous and os.clock()-previous.at<120 and previous.count+1 or 1
                failures[corridor]={count=count,at=os.clock()}
                if count>=3 and returned then f.motionEdges[corridor]=os.clock()+retryDelay end
