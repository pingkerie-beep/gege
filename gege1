local function pnbFitScale(percent, viewport)
    return math.max(.1, math.min(percent / 100,
        math.max(1, viewport.X - 24) / 500,
        math.max(1, viewport.Y - 48) / ((useMobileSizing and 275 or 475) + 40)))
end
local function pnbUpdateLayout(center)
    if pnbLayoutBusy or rayfieldDestroyed then return end
    pnbLayoutBusy = true
    local viewport = pnbViewport()
    -- Reserve space for the drag handle as well as the expanded window.
    pnbEffectiveScale = pnbFitScale(pnbPreferredScale, viewport)
    pnbWindowScale.Scale = pnbEffectiveScale
    if pnbDragScale then pnbDragScale.Scale = pnbEffectiveScale end
    local position = Main.Position
    local anchor = Main.AnchorPoint
    local width = (Main.Size.X.Scale * viewport.X + Main.Size.X.Offset) * pnbEffectiveScale
    local height = (Main.Size.Y.Scale * viewport.Y + Main.Size.Y.Offset) * pnbEffectiveScale
    local x = center and viewport.X / 2 or position.X.Scale * viewport.X + position.X.Offset
    local y = center and viewport.Y / 2 or position.Y.Scale * viewport.Y + position.Y.Offset
    local minX, maxX = 12 + width * anchor.X, viewport.X - 12 - width * (1 - anchor.X)
    local minY, maxY = 12 + height * anchor.Y, viewport.Y - 12 - height * (1 - anchor.Y) - 30 * pnbEffectiveScale
    x = math.clamp(x, minX, math.max(minX, maxX))
    y = math.clamp(y, minY, math.max(minY, maxY))
    -- Relative coordinates keep a dragged window reachable after screen rotation.
    local target = UDim2.new(x / viewport.X, 0, y / viewport.Y, 0)
    if center or math.abs(x - (position.X.Scale * viewport.X + position.X.Offset)) > .5
        or math.abs(y - (position.Y.Scale * viewport.Y + position.Y.Offset)) > .5 then
        Main.Position = target
    end
    if dragBar then
        dragBar.Position = UDim2.new(Main.Position.X.Scale, Main.Position.X.Offset,
            Main.Position.Y.Scale, Main.Position.Y.Offset + (useMobileSizing and dragOffsetMobile or dragOffset) * pnbEffectiveScale)
    end
    pnbLayoutBusy = false
    if pnbResizeRefresh then pnbResizeRefresh() end
end
local function pnbSetUIScale(percent, origin)
    if type(percent) ~= "number" or percent ~= percent or percent == math.huge or percent == -math.huge then return false end
    pnbPreferredScale = math.clamp(percent, 50, 130)
    if origin then
        local scale = pnbFitScale(pnbPreferredScale, pnbViewport())
        -- Grow from the opposite corner instead of expanding around the center.
        pnbLayoutBusy = true
        Main.Position = UDim2.new(0, origin.x + origin.width * scale * Main.AnchorPoint.X,
            0, origin.y + origin.height * scale * Main.AnchorPoint.Y)
        pnbLayoutBusy = false
    end
    pnbUpdateLayout(false)
    if type(RayfieldLibrary.OnUIScaleChanged) == "function" then
        pcall(RayfieldLibrary.OnUIScaleChanged, pnbPreferredScale)
    end
    return true
end
