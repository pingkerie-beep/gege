        if f.target and (f.target.kind=="plant" or f.target.kind=="harvest") then
            f.blockedOrder=f.target;f.routeRetryAt=os.clock()+2
            farmNote="The supported step was rejected; the first eligible tile stays selected."
            f.stepRejected=nil
