			RayfieldLibrary:Notify({Title = 'Theme Changed', Content = 'Successfully changed theme to '..(typeof(NewTheme) == 'string' and NewTheme or 'Custom Theme')..'.', Image = 4483362748})
		end
	end

	local success, result = pcall(function()
		createSettings(Window)
	end)

	if not success then warn('Rayfield had an issue creating settings.') end

	-- Report after createSettings so loadSettings() has run and usageAnalytics reflects the user's saved preference
	if analyticsAllowed() and loadReporter() then
		local themeName = "Default"
		if Settings.Theme then
			if type(Settings.Theme) == "string" then
				themeName = Settings.Theme
			elseif type(Settings.Theme) == "table" then
				themeName = "Custom"
			end
		end

		local discordInvite = nil
		if Settings.Discord and Settings.Discord.Enabled and Settings.Discord.Invite and Settings.Discord.Invite ~= "" then
			local raw = tostring(Settings.Discord.Invite)
			-- Normalize: strip URL prefixes to extract just the invite code
			discordInvite = (raw:match("discord%.gg/([%w%-]+)") or raw:match("discord%.com/invite/([%w%-]+)") or raw):sub(1, 32)
		end

		local sampleSend = false

		-- Random Sampling Test
		if not Settings.ScriptID and math.random() > 0.4 then
			sampleSend = true
		end

		--if Settings.ScriptID then
			reporter:windowCreated({
				script_name        = Settings.Name or "Unknown",
				script_version     = Release,
				interface_version  = InterfaceBuild,
				theme              = themeName,
				is_mobile          = useMobileSizing and true or false,
				has_key_system     = Settings.KeySystem and true or false,
				discord_invite     = discordInvite,
				config_saving      = (Settings.ConfigurationSaving and Settings.ConfigurationSaving.Enabled) and true or false,
				script_id          = Settings.ScriptID or sampleSend and 'sid_tzfyxawonjx9' or nil,
				verification_token = Settings.VerificationToken,
			})
		--end
	end

    -- An owned community control, separate from Rayfield's Discord RPC integration.
    do
        local invite=Settings.CommunityInvite
        if type(invite)=="string" and invite:match("^https://discord%.gg/[%w%-]+$") then
            local links={}
            local function watch(signal,callback)
                links[#links+1]=signal:Connect(callback)
            end
            local function create(class,props,parent)
                local object=Instance.new(class)
                for key,value in pairs(props) do object[key]=value end
                object.Parent=parent;return object
            end
            local function round(object,radius)
                create("UICorner",{CornerRadius=UDim.new(0,radius)},object)
            end
            local white=Color3.fromRGB(255,255,255)
            local accent=Color3.fromRGB(88,101,242)
            -- Preserve the tab row's left edge even when it is center anchored.
            local size,position=TabList.Size,TabList.Position
            TabList.Size=UDim2.new(size.X.Scale,size.X.Offset-100,size.Y.Scale,size.Y.Offset)
            TabList.Position=UDim2.new(position.X.Scale,position.X.Offset-100*TabList.AnchorPoint.X,
                position.Y.Scale,position.Y.Offset)
            local button=create("TextButton",{Name="GenHubDiscord",Text="Discord",TextSize=13,
                Font=Enum.Font.GothamMedium,TextColor3=white,BackgroundColor3=accent,
                BorderSizePixel=0,AutoButtonColor=true,Visible=false,ZIndex=15,
                AnchorPoint=Vector2.new(1,TabList.AnchorPoint.Y),Size=UDim2.fromOffset(86,32),
                Position=UDim2.new(1,-18,position.Y.Scale,position.Y.Offset)},Main)
            round(button,16)
            local panel=create("Frame",{Name="GenHubCommunity",Visible=false,Active=true,
                BorderSizePixel=0,ZIndex=40,AnchorPoint=Vector2.new(1,0),
                Size=UDim2.new(1,-36,0,178),Position=UDim2.new(1,-18,0,96)},Main)
            create("UISizeConstraint",{MaxSize=Vector2.new(300,178)},panel)
            round(panel,12)
            local stroke=create("UIStroke",{Thickness=1,Transparency=.2},panel)
            local title=create("TextLabel",{Name="Title",Text="GenHub Discord",TextSize=16,
                Font=Enum.Font.GothamSemibold,BackgroundTransparency=1,TextXAlignment=Enum.TextXAlignment.Left,
                Position=UDim2.fromOffset(14,13),Size=UDim2.new(1,-56,0,24),ZIndex=41},panel)
            local close=create("TextButton",{Name="Close",Text="×",TextSize=22,Font=Enum.Font.Gotham,
                BackgroundTransparency=1,BorderSizePixel=0,Position=UDim2.new(1,-38,0,10),
                Size=UDim2.fromOffset(28,28),ZIndex=42},panel)
            local description=create("TextLabel",{Name="Description",TextSize=12,Font=Enum.Font.Gotham,
                BackgroundTransparency=1,TextXAlignment=Enum.TextXAlignment.Left,TextWrapped=true,
                Position=UDim2.fromOffset(14,42),Size=UDim2.new(1,-28,0,32),ZIndex=41},panel)
            local url=create("TextBox",{Name="Invite",Text=invite,TextSize=12,Font=Enum.Font.Gotham,
                ClearTextOnFocus=false,TextEditable=false,TextXAlignment=Enum.TextXAlignment.Center,
                BorderSizePixel=0,Position=UDim2.fromOffset(14,82),Size=UDim2.new(1,-28,0,28),ZIndex=41},panel)
            round(url,6)
            local join=create("TextButton",{Name="JoinServer",Text="Join Server",TextSize=13,
                Font=Enum.Font.GothamSemibold,TextColor3=white,BackgroundColor3=accent,AutoButtonColor=true,
                BorderSizePixel=0,Position=UDim2.fromOffset(14,124),Size=UDim2.new(1,-28,0,36),ZIndex=41},panel)
            round(join,8)
            local function reset()
                join.Text="Join Server"
                description.Text="Get updates and support from the community."
            end
            local function theme()
                panel.BackgroundColor3=SelectedTheme.ElementBackground or SelectedTheme.Background
                stroke.Color=SelectedTheme.ElementStroke
                title.TextColor3=SelectedTheme.TextColor;close.TextColor3=SelectedTheme.TextColor
                description.TextColor3=SelectedTheme.TextColor;description.TextTransparency=.2
                url.TextColor3=SelectedTheme.TextColor
                url.BackgroundColor3=SelectedTheme.Background
            end
            local function refresh()
                local available=not rayfieldDestroyed and Rayfield.Enabled and Main.Visible and TabList.Visible
                    and not Hidden and not Minimised and not searchOpen and Main.Size.Y.Offset>160
                button.Visible=available
                if not available then panel.Visible=false end
            end
            local function copyInvite()
                local candidates={}
                local function add(fn) if type(fn)=="function" then candidates[#candidates+1]=fn end end
                add(setclipboard);add(toclipboard)
                if type(syn)=="table" then add(syn.write_clipboard) end
                if type(getgenv)=="function" then
                    local ok,environment=pcall(getgenv)
                    if ok and type(environment)=="table" then
                        add(environment.setclipboard);add(environment.toclipboard)
                        if type(environment.syn)=="table" then add(environment.syn.write_clipboard) end
                    end
                end
                for _,copy in ipairs(candidates) do
                    local ok,result=pcall(copy,invite)
                    if ok and result~=false then return true end
                end
                return false
            end
            watch(button.Activated,function()
                refresh()
                if button.Visible then reset();panel.Visible=not panel.Visible end
            end)
            watch(close.Activated,function() panel.Visible=false end)
            watch(join.Activated,function()
                refresh()
                if not button.Visible or not panel.Visible then return end
                if copyInvite() then
                    join.Text="Link Copied"
                    description.Text="Invite link copied. Paste it in Discord to join."
                else
                    join.Text="Copy Invite"
                    description.Text="Clipboard unavailable. Select and copy the invite below."
                end
            end)
            watch(url.Focused,function() url.SelectionStart=1;url.CursorPosition=#invite+1 end)
            for _,entry in ipairs({{Rayfield,"Enabled"},{Main,"Visible"},{Main,"Size"},
                {TabList,"Visible"},{Main.Search,"Visible"},{Main.Search.Input,"Interactable"}}) do
                watch(entry[1]:GetPropertyChangedSignal(entry[2]),refresh)
            end
            watch(Main:GetPropertyChangedSignal("BackgroundColor3"),theme)
            Rayfield.Destroying:Connect(function()
                for _,connection in ipairs(links) do connection:Disconnect() end
            end)
            reset();theme();refresh()
        end
    end

	return Window
end

local function setVisibility(visibility: boolean, notify: boolean?)
	if Debounce then return end
	if visibility then
		Hidden = false
		Unhide()
	else
		Hidden = true
		Hide(notify)
	end
end

function RayfieldLibrary:SetVisibility(visibility: boolean)
	setVisibility(visibility, false)
end

function RayfieldLibrary:IsVisible(): boolean
	return not Hidden
end

local hideHotkeyConnection -- Has to be initialized here since the connection is made later in the script
function RayfieldLibrary:Destroy()
	rayfieldDestroyed = true
	siaCall("window", "close")
	-- stops the kick watcher the reporter armed, so nothing is sent for a window that's gone
	if reporter and reporter.disable then
		pcall(reporter.disable, reporter)
	end
	if hideHotkeyConnection then
		hideHotkeyConnection:Disconnect()
	end
	for _, connection in keybindConnections do
		connection:Disconnect()
	end
	Rayfield:Destroy()
end

