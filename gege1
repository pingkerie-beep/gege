        table.insert(status,"PNB animations: "..(not effects.hands and "Off" or binding and type(binding.pnbAnimation)=="table" and not binding.pnbAnimation.disabled and "Ready" or "Unavailable"))
        table.insert(status,"PNB sounds: "..(not effects.sounds and "Off" or binding and type(binding.pnbSound)=="table" and not binding.pnbSound.disabled and "Ready" or "Unavailable"))
        table.insert(status,"Block break effects: "..(not effects.blocks and "Off" or binding and type(binding.pnbBlockEffects)=="table" and not binding.pnbBlockEffects.disabled and "Ready" or "Unavailable"))
