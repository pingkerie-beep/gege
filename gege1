        if math.abs(x-gx)>.18 or math.abs(y-gy)>.18 then failed("position returned before supported arrival",true);return end
        if not standing or farmBoxHits(n,x,y) then failed("destination support changed");return end
        if s.grounded~=true or os.clock()-step.at<.04 then
            if os.clock()-step.at>.6 then failed("native landing was not confirmed") end
            return
        end
        if not step.sentAt then
            m.x,m.y=x,y
