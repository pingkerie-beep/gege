    function ui.Rebuild()
        local b=bind(false)
        ui.db=b and b.itemDB or nil
        local rows,ids={},{}
        local function add(id,name)
            if not integer(id) or id<=0 or ids[id] or type(name)~="string" or name=="" then return end
            local native=entry(ui.db,id);local kind=type(native)=="table" and rawget(native,"kind")
            if kind=="seed" or name:match(" Seed$") then return end
            if type(ui.db)=="table" and not pair(ui.db,id) then return end
            local canonical=nativeName(ui.db,id,name)
            local seedName=nativeName(ui.db,id+1,reference[id+1] or (canonical.." Seed"))
            local row={id=id,name=canonical,seedName=seedName,available=pair(ui.db,id),
                label=clean(canonical).." ["..id.."]",find=folded(canonical.." "..seedName)}
            ids[id]=row;table.insert(rows,row)
        end
        for id,name in pairs(reference) do add(id,name) end
        local visited=0
        for id,definition in next,ui.db or {} do
            visited+=1;if visited>30000 then break end
            if integer(id) and id>0 and type(definition)=="table" and pair(ui.db,id) then add(id,nativeName(ui.db,id,reference[id])) end
        end
        table.sort(rows,function(a,b)
            if a.available~=b.available then return a.available end
            if a.name:lower()==b.name:lower() then return a.id<b.id end
            return a.name:lower()<b.name:lower()
        end)
        ui.rows,ui.byId=rows,ids;ui.availableCount=0
        for _,row in ipairs(rows) do if row.available then ui.availableCount+=1 end end
    end
    function ui.Search()
        local matches={};local number=tonumber(ui.query)
        for _,row in ipairs(ui.rows) do
            local match=true
            if number then match=row.id==number or row.id+1==number
            else for word in ui.query:gmatch("%S+") do if not row.find:find(word,1,true) then match=false;break end end end
            if match then table.insert(matches,row) end
        end
        ui.matchCount=#matches;ui.pages=math.max(1,math.ceil(#matches/ui.pageSize));ui.page=math.min(ui.page,ui.pages)
        local labels,map={},{}
        for i=(ui.page-1)*ui.pageSize+1,math.min(ui.page*ui.pageSize,#matches) do
            local row=matches[i];table.insert(labels,row.label);map[row.label]=row
        end
        if #labels==0 then labels={"No matching blocks"} end
        ui.options=map
        ui.updating=true;dropdown:Refresh(labels);ui.updating=false
        paragraph(catalogInfo,"Search Results",string.format("%d results • Page %d of %d\nType in the search box to find a block. Seeds are selected automatically.",#matches,ui.page,ui.pages))
    end
