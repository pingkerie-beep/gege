            farmNote=p.status;return
        end
        local ready,s=pcall(farm.native.getState)
        if not ready or type(s)~="table" or s.active~=true or s.dead~=false then
            stopFarm();p.job=nil;p.inventoryReady=nil
            p.status="Waiting for the character to become active. Start Farm remains on.";farmNote=p.status;return
        end
