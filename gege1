        -- exceeds the old fixed .18 tolerance without being a server rollback.
        -- Only accept a bounded fall consistent with the current native velocity;
        -- the complete reverse body segment still has to be collision-clear.
        -- Landing zeroes vy, so include the native gravity tick as well as
        -- the remaining velocity. The bound stays capped at two tiles.
        local fallTolerance=math.max(.18,math.min(2,math.max(0,s.vy or 0)*elapsed+55*elapsed*elapsed+.03))
        if math.abs(x-transfer.x)>.18 or y<transfer.y-.18 or y-transfer.y>fallTolerance then
            failed(string.format("clear edge transfer was returned (actual %.3f,%.3f; planned %.3f,%.3f; vy %.3f; dt %.3f)",
                x,y,transfer.x,transfer.y,s.vy or 0,elapsed),true);return
        end
        if farmBoxHits(n,x,y) then failed("clear edge transfer is obstructed");return end
        -- Publish the position and flags produced by the preceding native tick.
        -- Never publish a newly unsupported waypoint with the old grounded flag.
        if os.clock()>=m.nextSend and os.clock()-transfer.at>=.02 then
            m.x,m.y=x,y
