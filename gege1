            local tag=camera and camera:FindFirstChild("NameTag")
            if not isGui(tag,"Frame") and binding and (binding.template or binding.runtime) and binding.gameGui==gui then
                local values=type(binding.renderer)=="function" and upvalues(binding.renderer)
