-- GenHub compatibility inspector 2.3: bounded, read-only game inspection.
-- No game actions, remote calls, hooks, getgc or changes to live state.
local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local Run=game:GetService("RunService")
local player=Players.LocalPlayer
local playerGui=player and player:FindFirstChild("PlayerGui")
local playerScripts=player and player:FindFirstChild("PlayerScripts")
local remotes=RS:FindFirstChild("WorldRemotes")
local version=tostring(game.PlaceVersion)
local lines={"GenHub compatibility inspector 2.3 | Game version "..version,
    "UTC: "..os.date("!%Y-%m-%dT%H:%M:%SZ"),
    "Read-only: no game actions, remotes, hooks or garbage-collector scans."}
local function add(value) lines[#lines+1]=tostring(value) end
local function read(object,key)
    local ok,value=pcall(function() return object[key] end)
    return ok and value or nil
end
local function path(object)
    if typeof(object)~="Instance" then return typeof(object) end
    local ok,value=pcall(function() return object:GetFullName() end)
    return ok and value or "unavailable"
end
local function owned(object)
    if typeof(object)~="Instance" then return false end
    return playerGui and object:IsDescendantOf(playerGui)
        or playerScripts and object:IsDescendantOf(playerScripts)
end
local function owner(fn)
    local ok,scope=pcall(getfenv,fn)
    return ok and type(scope)=="table" and read(scope,"script") or nil
end
local getValues=type(debug)=="table" and debug.getupvalues
local getConstants=type(debug)=="table" and debug.getconstants
local getInfo=type(debug)=="table" and debug.info
local function refs(fn)
    if type(fn)~="function" or type(getValues)~="function" then return nil end
    local ok,value=pcall(getValues,fn)
    return ok and type(value)=="table" and value or nil
end
local markers={"punchFresh","punchPressed","GetServerTimeNow","Debug","active","dead","x","y","vx","vy",
    "seedHeld","plant","pressPunch","canEdit","uid","n","dropArrived","id","goTo","MoveTo","takeDrop","Net","send","flags"}
local function functionInfo(fn)
    local selected={}
    if type(getConstants)=="function" then
        local ok,values=pcall(getConstants,fn)
        if ok and type(values)=="table" then
            local found={}
            for _,value in pairs(values) do if type(value)=="string" then found[value]=true end end
            for _,name in ipairs(markers) do if found[name] then selected[#selected+1]=name end end
        end
    end
    local arity,vararg="?","?"
    if type(getInfo)=="function" then
        local ok,a,v=pcall(getInfo,fn,"a")
        if ok then arity,vararg=tostring(a),tostring(v) end
    end
    return "owner="..path(owner(fn)).." args="..arity.." variadic="..vararg.." markers="..table.concat(selected,",")
end
local candidates,seenScripts={},{}
local function candidate(scriptObject,reason,priority,runtime)
    local shared=RS:FindFirstChild("Shared")
    local allowed=runtime==true or owned(scriptObject) or typeof(scriptObject)=="Instance" and shared and scriptObject:IsDescendantOf(shared)
    if not allowed or typeof(scriptObject)~="Instance"
        or not (scriptObject:IsA("LocalScript") or scriptObject:IsA("ModuleScript") or scriptObject:IsA("Script")) then return end
    local previous=seenScripts[scriptObject]
    if previous then
        if (priority or 0)>previous.priority then previous.reason,previous.priority=reason,priority end
        return
    end
    local entry={object=scriptObject,reason=reason,priority=priority or 0}
    seenScripts[scriptObject]=entry;candidates[#candidates+1]=entry
end
local function yieldRead()
    if type(task)=="table" and type(task.wait)=="function" then task.wait() end
end
local function inventory(root,label)
    add("\n["..label.."] "..path(root))
    if not root then return end
    local queue,head={{root,0}},1
    local inspected,listed=0,0
    while head<=#queue and inspected<1800 do
        if inspected>0 and inspected%128==0 then yieldRead() end
        local entry=queue[head];head+=1;inspected+=1
        local object,depth=entry[1],entry[2]
        local name=object.Name
        local relevant=depth==0 or depth==1 or name=="Camera" or name=="NameTag" or name=="Debug"
            or object:IsA("LocalScript") or object:IsA("ModuleScript")
        if relevant and listed<150 then
            local suffix=""
            if object:IsA("GuiObject") then suffix=" Visible="..tostring(object.Visible) end
            if object:IsA("ScreenGui") then suffix=" Enabled="..tostring(object.Enabled) end
            add(path(object).." | "..object.ClassName..suffix);listed+=1
            if name=="Debug" and object:IsA("TextLabel") then
                add("Debug label: "..string.format("%q",object.Text:sub(1,600)))
            end
        end
        if object:IsA("LocalScript") and name=="Game" then candidate(object,"named Game") end
        if object:IsA("ModuleScript") and name=="Others" then candidate(object,"native movement module") end
        if object:IsA("ModuleScript") and name=="WorldMenu" then candidate(object,"native menu module") end
        if depth<6 and name~="Camera" and name~="TextureKeep" and name~="Chat" and name~="ChatUI" and name~="TextChatService" then
            for _,child in ipairs(object:GetChildren()) do
                if #queue>=2500 then break end
                queue[#queue+1]={child,depth+1}
            end
        elseif name=="Camera" then
            local names={}
            for i,child in ipairs(object:GetChildren()) do
                if i>24 then break end
                names[#names+1]=child.Name.."("..child.ClassName..")"
            end
            add("Camera children: "..table.concat(names,","))
        end
    end
    add("Inspected="..inspected.." listed="..listed.." queued="..#queue)
end
add("APIs: getconnections="..type(getconnections).." getupvalues="..type(getValues)
    .." getconstants="..type(getConstants).." getscriptbytecode="..type(getscriptbytecode))
inventory(playerGui,"PlayerGui structure")
inventory(playerScripts,"PlayerScripts structure")
inventory(playerGui and playerGui:FindFirstChild("GameGui"),"GameGui focused structure")
local shared=RS:FindFirstChild("Shared")
if shared then
    add("\n[Shared modules]")
    for _,child in ipairs(shared:GetChildren()) do
        add(path(child).." | "..child.ClassName)
        if child.Name=="Net" or child.Name=="Mix" then candidate(child,"native network resolver") end
    end
end
add("\n[WorldRemotes] "..path(remotes))
if remotes then
    local descriptions={}
    for _,remote in ipairs(remotes:GetChildren()) do descriptions[#descriptions+1]=remote.Name.."("..remote.ClassName..")" end
    table.sort(descriptions)
    for i=1,math.min(#descriptions,140) do add(descriptions[i]) end
end
local scalarFields={"name","w","h","dead","ghost","hp","active","x","y","vx","vy","grounded","gravityScale","antiGravOn"}
local stateFields={"goTo","enter","call","takeDrop","fg","bg","tree","trees","itemDB","playerView"}
local function tableInfo(value)
    local fields={}
    for _,key in ipairs(scalarFields) do
        local v=rawget(value,key)
        if type(v)=="number" or type(v)=="boolean" or key=="name" and type(v)=="string" then
            fields[#fields+1]=key.."="..(type(v)=="string" and string.format("%q",v:sub(1,80)) or tostring(v))
        end
    end
    for _,key in ipairs(stateFields) do
        local v=rawget(value,key)
        if v~=nil then fields[#fields+1]=key..":"..type(v) end
    end
    return table.concat(fields," ")
end
local function details(fn,label,deep)
    add(label.." "..functionInfo(fn))
    local values=refs(fn)
    if not values then add("upvalues unavailable");return end
    local count=0
    for index,value in pairs(values) do
        count+=1;if count>180 then add("upvalue list capped");break end
        local kind=type(value)
        local note=kind
        if kind=="number" or kind=="boolean" then note=kind.."="..tostring(value)
        elseif typeof(value)=="Instance" then note=value.ClassName.." "..path(value)
        elseif kind=="table" then
            note="table "..tableInfo(value)
            local goTo=rawget(value,"goTo")
            if deep and type(goTo)=="function" then details(goTo,"  goTo at slot "..tostring(index),false) end
        elseif kind=="function" and deep then note=functionInfo(value)
        end
        add("  ["..tostring(index).."] "..note)
    end
end
local totalCallbacks=0
local function inspectSignal(signal,label,limit)
    add("\n[Callbacks "..label.."]")
    if not signal or type(getconnections)~="function" then add("unavailable");return end
    local ok,list=pcall(getconnections,signal)
    if not ok or type(list)~="table" then add("unavailable");return end
    add("connections="..#list)
    local seen={}
    for index,connection in ipairs(list) do
        if index>limit or totalCallbacks>=160 then add("inspection capped");break end
        local fn=read(connection,"Function")
        if index<=24 and label=="RenderStepped" then
            add("connection "..index.." Function="..type(fn).." Enabled="..tostring(read(connection,"Enabled"))
                ..(type(fn)=="function" and " owner="..path(owner(fn)) or ""))
        end
        if type(fn)=="function" and not seen[fn] then
            seen[fn]=true
            local scriptObject=owner(fn)
            if owned(scriptObject) then
                totalCallbacks+=1
                candidate(scriptObject,label.." callback")
                if totalCallbacks<=32 then details(fn,"callback "..index,true)
                else add("callback "..index.." "..functionInfo(fn)) end
            end
        end
    end
end
inspectSignal(Run.RenderStepped,"RenderStepped",96)
for _,name in ipairs({"MoveTo","DropAdded","DropTaken","InventorySync","WorldClosed","TreeChanged"}) do
    local remote=remotes and remotes:FindFirstChild(name)
    inspectSignal(remote and remote:IsA("RemoteEvent") and remote.OnClientEvent,name,16)
end

add("\n[Native renderer and packet registry]")
local function has(fn,keys)
    if type(fn)~="function" or type(getConstants)~="function" then return false end
    local ok,values=pcall(getConstants,fn);if not ok or type(values)~="table" then return false end
    local found={};for _,value in pairs(values) do if type(value)=="string" then found[value]=true end end
    for _,key in ipairs(keys) do if not found[key] then return false end end
    return true
end
local ok,list=pcall(getconnections,Run.RenderStepped)
local verifiedStates={}
local function rendererContext(fn)
    local values=refs(fn)
    local gui=playerGui and playerGui:FindFirstChild("GameGui")
    if not values or not gui then return nil end
    local state,frames
    frames={}
    local count=0
    for _,value in pairs(values) do
        count+=1;if count>180 then break end
        if type(value)=="table" and type(rawget(value,"fg"))=="table"
            and type(rawget(value,"w"))=="number" and type(rawget(value,"h"))=="number"
            and type(rawget(value,"goTo"))=="function" then state=value end
        if typeof(value)=="Instance" and value:IsA("GuiObject") and value:IsDescendantOf(gui) then
            frames[value]=true
        end
    end
    for frame in pairs(frames) do
        if frames[frame.Parent] and state then return state end
    end
    return nil
end
local function runtimeModules(state)
    for _,value in pairs(refs(rawget(state,"enter")) or {}) do
        if type(value)=="table" and type(rawget(value,"update"))=="function" and type(rawget(value,"sendHit"))=="function" then
            local update,sendHit=rawget(value,"update"),rawget(value,"sendHit")
            if owner(update)==owner(sendHit) then
                candidate(owner(update),"RuntimeOthers",90,true)
                details(update,"Runtime Others.update",false)
                for _,sender in pairs(refs(update) or {}) do
                    if type(sender)=="function" and has(sender,{"state","move","send","flags"}) then
                        details(sender,"Runtime movement sender",true)
                        for _,network in pairs(refs(sender) or {}) do
                            if type(network)=="table" and type(rawget(network,"EVENTS"))=="table" and type(rawget(network,"call"))=="function" then
                                candidate(owner(rawget(network,"call")),"RuntimeNet",80,true)
                            end
                        end
                    end
                end
            end
        end
    end
end
if ok and type(list)=="table" then
    for index,connection in ipairs(list) do
        if index>64 then break end
        local fn=read(connection,"Function")
        local context=read(connection,"Enabled")~=false and type(fn)=="function" and rendererContext(fn)
        if has(fn,{"punchFresh","punchPressed","GetServerTimeNow"}) or context then
            yieldRead()
            details(fn,"renderer",true)
            local rv=refs(fn);local state=context or rv and rv[1]
            if type(state)=="table" and not verifiedStates[state] then
                verifiedStates[state]=true
                if context then
                    candidate(owner(fn),"RuntimeGame",100,true)
                    runtimeModules(state)
                end
                local keys={};for key,value in pairs(state) do if type(key)=="string" then keys[#keys+1]=key..":"..type(value) end end
                table.sort(keys);add("State keys: "..table.concat(keys,","))
                for _,key in ipairs({"enter","dropArrived","dropTaken","treeChanged","tileChanged","takeDrop"}) do
                    local action=rawget(state,key);if type(action)=="function" then details(action,"State."..key,true) end
                end
                local ev=refs(rawget(state,"enter"));local others
                for _,value in pairs(ev or {}) do
                    if type(value)=="table" and type(rawget(value,"update"))=="function" and type(rawget(value,"sendHit"))=="function" then others=value;break end
                end
                local uv=type(others)=="table" and refs(rawget(others,"update"))
                local sender=uv and uv[1];local sv=refs(sender);local net=sv and sv[5]
                for _,value in pairs(sv or {}) do
                    if type(value)=="table" and type(rawget(value,"EVENTS"))=="table" then net=value;break end
                end
                if type(sender)=="function" then details(sender,"Native sender",true) end
                if type(net)=="table" then
                    local keys={};for key,value in pairs(net) do if type(key)=="string" then keys[#keys+1]=key..":"..type(value) end end
                    table.sort(keys);add("Net keys: "..table.concat(keys,","))
                    local events=rawget(net,"EVENTS")
                    for _,name in ipairs({"MoveTo","InventorySync","WorldClosed","TreeChanged","DropAdded","DropTaken","DisplayChanged","LevelUp"}) do
                        yieldRead()
                        local def=type(events)=="table" and rawget(events,name)
                        local packet=type(def)=="table" and rawget(net,rawget(def,"packet"))
                        add("Event "..name.." def="..type(def).." packet="..type(packet))
                        if type(packet)=="table" then
                            local queue={{rawget(packet,"listen"),"listen",0}}
                            local head,seen,nodes=1,{},0
                            while head<=#queue and nodes<100 do
                                local e=queue[head];head+=1;local v,label,depth=e[1],e[2],e[3]
                                if (type(v)=="table" or type(v)=="function") and not seen[v] then
                                    seen[v]=true;nodes+=1
                                    add(name.."."..label.." "..(type(v)=="function" and functionInfo(v) or "table"))
                                    local children=type(v)=="function" and refs(v) or v
                                    if type(v)=="function" and children and children[1]==def and children[2]==net and type(children[4])=="function" then
                                        details(children[4],name.." native callback",true)
                                    end
                                    if children and depth<5 then
                                        local n=0;for key,child in pairs(children) do
                                            n+=1;if n>40 then break end
                                            if type(child)=="function" or type(child)=="table" then queue[#queue+1]={child,label.."/"..tostring(key),depth+1} end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end
add("\n[Read-only controller exports]")
table.sort(candidates,function(a,b) return a.priority>b.priority end)
local bytesSaved,exports=0,0
if type(writefile)=="function" and type(getscriptbytecode)=="function" then
    for _,entry in ipairs(candidates) do
        if exports>=12 or bytesSaved>=5000000 then add("export limit reached");break end
        yieldRead()
        local object=entry.object
        local ok,bytes=pcall(getscriptbytecode,object)
        if ok and type(bytes)=="string" and #bytes>0 and #bytes<2000000 and bytesSaved+#bytes<=5000000 then
            local stem=(entry.priority>0 and entry.reason or object.Name):gsub("[^%w_]","_"):sub(1,40)
            local filename="PNBRange_Compat_"..version.."_"..tostring(exports+1).."_"..stem..".luauc"
            local saved=pcall(writefile,filename,bytes)
            add(path(object).." | "..entry.reason.." | "..filename.." | bytes="..#bytes.." saved="..tostring(saved))
            if saved then bytesSaved+=#bytes;exports+=1 end
        else add(path(object).." | bytecode unavailable or capped") end
    end
end
add("Exported="..exports.." bytes="..bytesSaved.." callbacks inspected="..totalCallbacks)
local report=table.concat(lines,"\n")
if type(writefile)=="function" then
    local ok=pcall(writefile,"PNBRange_Compatibility.txt",report)
    if ok then print("[GenHub] Compatibility report saved | inspector 2.3 | game v"..version);return end
end
print(report)
