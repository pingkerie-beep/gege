    if a.prep then startupBreak(a,x,y);return end
    if (a.stage=="TANAM" or a.stage=="PANEN" or a.stage=="TUNGGU")
        and ((a.blocks or 0)>=200 or (inventoryNumber(a.native.b,"count",a.block) or 0)>=200) then
        f.motion,f.target,f.scan=nil,nil,nil;f.pathSearch=nil;f.candidates={}
        if not a.job then a.nextCheck=0 end
    end
    if f.motion or f.target and (a.stage=="TANAM" or a.stage=="PANEN" or a.stage=="TUNGGU") then return end
    if a.job then
        if not a.job.done then
            if os.clock()-a.job.started>=CONFIG.rpcTimeout then halt("Pemeriksaan inventory siklus belum dijawab.") end
            return
        end
        if not loopInventory(a,a.job.reply,a) then return end
        a.job=nil
    end
    if (lease.outstanding or 0)>0 then return end
    if os.clock()>=a.nextCheck then
        request(a,rpcFor(a.native.b,"GetInventory"));return
    end
    if a.blocks>=200 and a.stage~="PNB" then
        a.home={x=x,y=y,tx=math.floor(x),ty=math.floor(y-.475)-1};a.prepare=true;a.settle=nil
        loopStage(a,"PNB");log("STOK BLOK 200: hentikan harvest berikutnya, prioritaskan PNB.")
    end
    if a.seeds>=200 then
        if os.clock()<(a.nextDepositAt or 0) then farmNote="Menunggu box siap; siklus tetap ON.";return end
        if a.stage~="SETOR" then a.depositResume=a.stage end
        loopStage(a,"SETOR");depositTick(a,x,y);return
    end
    if a.stage=="CEK" then
        if a.blocks>0 or a.prepare and farmTile(a.native,a.home.tx,a.home.ty,a.layer)==a.block then loopStage(a,"PNB")
        else loopStage(a,a.seeds>0 and "TANAM" or "PANEN") end
    end
    if a.stage=="PNB" then
        if a.heldPNB then
            local h=a.heldPNB
            if h.world~=world then a.heldPNB=nil
            elseif math.abs(x-h.anchor.x)>.18 or math.abs(y-h.anchor.y)>.18 then
                local stand={x=math.floor(h.anchor.x),y=math.floor(h.anchor.y-.001),key=0,kind="pnb"}
                local route,why=farmPlan(f,stand,x,y)
                if not route then
                    if why~="planning" then halt("Tidak ada rute kembali ke blok PNB yang menunggu kolek.") end
                    return
