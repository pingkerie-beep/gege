        if math.abs(x-m.destX)<=.18 and math.abs(y-m.destY)<=.18 and farmStanding(n,x,y) then
            traceMotion(string.format("ARRIVED %s (%d,%d) supported %.3f,%.3f",f.target.kind,f.target.x,f.target.y,x,y))
