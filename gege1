        if checkpoint and checkpoint()==false then return false,"budget" end
        local key
        if segments then
            if x1==x2 then key="v:"..x1..":"..y1..":"..y2
            elseif y1==y2 then key="h:"..y1..":"..math.min(x1,x2)..":"..math.max(x1,x2) end
        end
        local known=key and segments[key]
        if known~=nil then return known,known and nil or "blocked" end
        if segments and x1==x2 then
            -- A solid point inside a vertical shaft rules it out immediately.
            -- Clear cached points never approve a segment: the full body sweep
            -- below remains required. This cache lives for this search only.
            local columns=barriers.columns
