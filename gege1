        -- can be rejected before sampling either horizontal leg.
        local vertical,reason=clearSegment(x,ay,x,by)
        if reason=="budget" then return nil,reason end
        if vertical then
            local exit,exitWhy=clearSegment(ax,ay,x,ay)
            if exitWhy=="budget" then return nil,exitWhy end
            if exit then
                local enter,enterWhy=clearSegment(x,by,bx,by)
                if enterWhy=="budget" then return nil,enterWhy end
                if enter then return {{x=x,y=ay},{x=x,y=by},{x=bx,y=by}} end
            end
        end
    end
    return nil,"blocked"
end
-- Routes between real supported stances, using the same body and directional
-- platform clearance as the no-jump executor.
local function farmSupportedRoute(n,sx,sy,gx,gy,deniedEdges,checkpoint)
    local width,height=n.width,n.height
    if not integer(width) or not integer(height) or width<1 or height<2
        or not integer(sx) or not integer(sy) or not integer(gx) or not integer(gy)
        or sx<0 or sx>=width or sy<0 or sy>=height-1
        or gx<0 or gx>=width or gy<0 or gy>=height-1 then
        return nil,"Supported route coordinates are outside the world."
    end
    local grid=n.b and rawget(n.b.state,"fg")
    local db=n.b and n.b.itemDB
    if type(grid)~="table" or type(db)~="table" then return nil,"Support grid is unavailable." end
    local started=os.clock()
    local deadline=started+CONFIG.pathTimeLimit
    local timedOut=false
    local function withinBudget()
        -- A cooperative caller owns its active CPU budget and may suspend this
        -- search here. Its heap, arc sampler and graph caches remain intact.
        if checkpoint then return checkpoint()~=false end
        return os.clock()<=deadline
