            a.badHomes=a.badHomes or {};a.badHomes[(a.home.sy or math.floor(a.home.y-.001))*a.native.width+(a.home.sx or math.floor(a.home.x))]=os.clock()+60
            a.home={x=x,y=y,tx=math.floor(x),ty=math.floor(y-.475)-1}
