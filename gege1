        local known=stanceRows[y]
        if known~=nil then return known or nil end
        local row,count={},0
        for x=0,width-1 do
            if x%16==0 and not withinBudget() then timedOut=true;return nil end
            if stance(x,y) then row[x]=true;count+=1 end
        end
        stanceRows[y]=count>0 and row or false
        return count>0 and row or nil
    end
