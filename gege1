local function farmWritePosition(n,x,y,syncCaches)
    if not n.glide then return pcall(n.b.positionFn,x-.5,y-1) end
    local ok,before=pcall(n.getState)
    if not ok or type(before)~="table" or before.active~=true or before.dead~=false then return false,"Native movement state is inactive." end
    for _,key in ipairs({"x","y","vx","vy"}) do
        if not finite(before[key]) then return false,"Native movement state is invalid." end
    end
    if syncCaches then
        local fn=n.b.positionFn
        local refs=upvalues(fn)
        if not ownedArity(fn,n.b.controller,2) or not hasConstants(fn,{"portalIn","portalGo","deadAt"})
            or not refs or not captures(refs,n.b.state) then
            return false,"Native supported-step cache contract is unavailable."
        end
        for _,index in ipairs({1,2,5,6,7,8,9,10}) do
            if not finite(refs[index]) then return false,"Native supported-step caches are invalid." end
        end
        if math.abs(refs[1]-before.x)>.01 or math.abs(refs[2]-before.y)>.01 then
            return false,"Native supported-step source differs from the actual position."
        end
        -- A single native arrival call synchronizes the previous-physics and
        -- render caches used by the game's displacement guard. Flat frames
        -- continue using small direct increments; this call is per step only.
        local moved,err=pcall(fn,x-.5,y-1)
        local readOK,after=pcall(n.getState)
        local nextRefs=upvalues(fn)
        if not moved or not readOK or type(after)~="table" or not nextRefs then
            return false,"Native supported step failed: "..tostring(err)
        end
        for _,index in ipairs({1,5,9}) do
            if not finite(nextRefs[index]) or math.abs(nextRefs[index]-x)>.00001 then
                return false,"Native horizontal step caches did not synchronize."
            end
        end
        for _,index in ipairs({2,6,10}) do
            if not finite(nextRefs[index]) or math.abs(nextRefs[index]-y)>.00001 then
                return false,"Native vertical step caches did not synchronize."
            end
        end
        if not finite(after.x) or not finite(after.y) or math.abs(after.x-x)>.00001 or math.abs(after.y-y)>.00001
            or after.vx~=0 or after.vy~=0 or nextRefs[7]~=0 or nextRefs[8]~=0 then
            return false,"Native supported-step readback failed; no movement packet was sent."
        end
        return true
    end
    local function write(px,py,vx,vy)
        debug.setupvalue(n.getState,3,px);debug.setupvalue(n.getState,4,py)
        debug.setupvalue(n.getState,5,vx);debug.setupvalue(n.getState,6,vy)
    end
    -- Change only the verified position/velocity cells. goTo also changes portal
    -- and render caches; it is a world-arrival operation, not a per-frame move.
    local written=pcall(write,x,y,0,0)
    local readOK,after=pcall(n.getState)
    local pv,rv=upvalues(n.b.positionFn),upvalues(n.render)
    if not written or not readOK or type(after)~="table" or not finite(after.x) or not finite(after.y)
        or math.abs(after.x-x)>.00001 or math.abs(after.y-y)>.00001 or after.vx~=0 or after.vy~=0
        or not pv or pv[1]~=x or pv[2]~=y or not rv or rv[20]~=x or rv[21]~=y then
        pcall(write,before.x,before.y,before.vx,before.vy)
        return false,"Native movement cells could not be verified; no movement packet was sent."
    end
    return true
end
