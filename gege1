    handle.Active = true
    handle.AutoButtonColor = false
    handle.Selectable = false
    handle.ZIndex = 30
    handle.Parent = Main
    local lines = {}
    for i = 1, 3 do
        local line = Instance.new("Frame")
        line.Name = "Grip" .. i
        line.AnchorPoint = Vector2.new(.5, .5)
        line.Rotation = -45
        line.BorderSizePixel = 0
        line.BackgroundColor3 = Color3.fromRGB(134, 194, 194)
        line.ZIndex = handle.ZIndex
        line.Parent = handle
        table.insert(lines, line)
    end
    local gesture
    local function stop()
        gesture = nil
        for _,line in ipairs(lines) do line.BackgroundColor3 = Color3.fromRGB(134, 194, 194) end
    end
    pnbResizeRefresh = function()
        local inverse = 1 / pnbEffectiveScale
        handle.Size = UDim2.new(0, 34 * inverse, 0, 34 * inverse)
        handle.Position = UDim2.new(1, -2 * inverse, 1, -2 * inverse)
        handle.Visible = Main.Visible and Main.Size.Y.Offset > 100
        for i,line in ipairs(lines) do
            line.Size = UDim2.new(0, (5 + i * 5) * inverse, 0, 1.5 * inverse)
            line.Position = UDim2.new(1, -(5 + i * 2) * inverse, 1, -(5 + i * 2) * inverse)
        end
        if gesture then
            local viewport = pnbViewport()
            local width = Main.Size.X.Scale * viewport.X + Main.Size.X.Offset
            local height = Main.Size.Y.Scale * viewport.Y + Main.Size.Y.Offset
            if not handle.Visible or viewport.X ~= gesture.viewportX or viewport.Y ~= gesture.viewportY
                or width ~= gesture.width or height ~= gesture.height then stop() end
        end
    end
    local function update(input)
        if not gesture then return end
        local dx, dy = input.Position.X - gesture.pointerX, input.Position.Y - gesture.pointerY
        if math.abs(dx) < 1 and math.abs(dy) < 1 then return end
        local horizontal, vertical = dx / gesture.width, dy / gesture.height
        local delta = math.abs(horizontal) >= math.abs(vertical) and horizontal or vertical
        local viewport = pnbViewport()
        local maximum = math.min(1.3, (viewport.X - 12 - gesture.x) / gesture.width,
            (viewport.Y - 12 - gesture.y) / (gesture.height + 30))
        local scale = math.clamp(gesture.scale + delta, math.min(.5, maximum), math.max(.5, maximum))
        pnbSetUIScale(scale * 100, gesture)
    end
    table.insert(pnbLayoutConnections, handle.InputBegan:Connect(function(input)
        if gesture or not handle.Visible or rayfieldDestroyed then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local viewport = pnbViewport()
        local width = Main.Size.X.Scale * viewport.X + Main.Size.X.Offset
        local height = Main.Size.Y.Scale * viewport.Y + Main.Size.Y.Offset
        if width <= 0 or height <= 0 then return end
        gesture = {input = input, pointerX = input.Position.X, pointerY = input.Position.Y,
            x = Main.Position.X.Scale * viewport.X + Main.Position.X.Offset - width * pnbEffectiveScale * Main.AnchorPoint.X,
            y = Main.Position.Y.Scale * viewport.Y + Main.Position.Y.Offset - height * pnbEffectiveScale * Main.AnchorPoint.Y,
            width = width, height = height, scale = pnbEffectiveScale, viewportX = viewport.X, viewportY = viewport.Y}
        for _,line in ipairs(lines) do line.BackgroundColor3 = Color3.fromRGB(218, 255, 255) end
    end))
    table.insert(pnbLayoutConnections, UserInputService.InputChanged:Connect(function(input)
        if not gesture then return end
        if input == gesture.input or gesture.input.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement then update(input) end
    end))
    table.insert(pnbLayoutConnections, UserInputService.InputEnded:Connect(function(input)
        if not gesture then return end
        if input == gesture.input or gesture.input.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1 then
            update(input)
            stop()
        end
    end))
    table.insert(pnbLayoutConnections, Main:GetPropertyChangedSignal("Visible"):Connect(pnbResizeRefresh))
    table.insert(pnbLayoutConnections, UserInputService.WindowFocusReleased:Connect(stop))
    handle.Destroying:Connect(stop)
    pnbResizeRefresh()
end



