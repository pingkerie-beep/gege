-- They are not movement packets, and no additional remote contract is guessed here.
local function action(place,c,b,lastHit,totalHits)
    if b.netCall then
        local native=autoLoop and autoLoop.native or settings.native
        if not native or native.b.state~=b.state then return false,"Kontrak aksi tile native belum cocok." end
        local ok,broken=pcall(function()
            local current=farmTile(native,c.x,c.y,c.layer)
            assert(c.layer~="bg" or farmTile(native,c.x,c.y,"fg")==0,"Petak BG tertutup blok FG.")
            if place then
                assert(current==0 and native.canPlace(b.itemDB[c.id],c.x,c.y),"Petak PNB tidak bisa ditanami blok ini.")
                native.setTile(c.layer,c.x,c.y,c.id,false,false)
                return false
            end
            assert(current==c.id,"Blok PNB berubah sebelum dipukul.")
            native.hit(c.x,c.y)
            return farmTile(native,c.x,c.y,c.layer)==0
        end)
        if not ok then return false,broken end
        playPNBAnimation(b,place,c.x,c.y)
        if place then playPNBSound(b,"place",c.id) end
        return true,nil,broken
    end
    local setTile=legacyRemote("SetTile")
    local byteNet=RS:FindFirstChild("ByteNetReliable")
    if not setTile or not setTile:IsA("RemoteEvent") or not byteNet or not byteNet:IsA("RemoteEvent") then
        return false,"SetTile/ByteNetReliable belum tersedia."
    end
    local ok,why=pcall(function()
        local packet=buffer.create(10)
        buffer.writeu8(packet,0,7);buffer.writef32(packet,1,c.y+.5)
        buffer.writeu8(packet,5,place and 2 or 6);buffer.writef32(packet,6,c.x+.5)
        setTile:FireServer(c.layer,c.x,c.y,place and c.id or 0,place and true or nil)
        byteNet:FireServer(packet,nil)
    end)
    if ok then
        playPNBAnimation(b,place,c.x,c.y)
        playPNBSound(b,place and "place" or lastHit and "break" or "hit",c.id)
        playBlockEffects(b,place,c,lastHit,totalHits)
    end
    return ok,why
end
local function updatePNB(b)
