        end
        if f.target and f.target.kind=="pnb" and os.clock()-(f.arrived or os.clock())<.4 then return end
        if f.target and f.target.kind=="pnb" and (math.abs(x-(f.target.x+.5))>.25 or math.abs(y-(f.target.y+.999))>.25) then
            a.badHomes=a.badHomes or {};a.badHomes[f.target.y*a.native.width+f.target.x]=os.clock()+60
            traceMotion("PNB anchor tidak stabil; memakai posisi yang sudah mendarat, tidak mengulang tujuan udara.")
