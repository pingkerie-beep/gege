local function rpcFor(b,name)
    if b and b.netCall then
        if name=="TakeDrop" then return b.takeDrop end
        if name=="GetInventory" or name=="GetGems" then
            return function() local value=b.netCall(name);return value end
        end
        if name=="DisplayItem" then return function(...) return b.netCall(name,...) end end
    end
    local remote=legacyRemote(name)
    return remote and remote:IsA("RemoteFunction") and remote or nil
end
local function request(p,remote,...)
    local args=table.pack(...)
    local job={started=os.clock(),done=false};p.job=job
    lease.outstanding=(lease.outstanding or 0)+1
    task.spawn(function()
        job.reply=table.pack(pcall(function()
            if type(remote)=="function" then return remote(table.unpack(args,1,args.n)) end
            return remote:InvokeServer(table.unpack(args,1,args.n))
        end))
        job.done=true;lease.outstanding=math.max(0,(lease.outstanding or 1)-1)
    end)
    return job
end
local function measure(reply,id)
    if not reply or not reply[1] or reply.n~=2 then return nil end
    local value=reply[2]
    if id==112 then return integer(value) and value>=0 and value or nil end
    if type(value)~="table" or type(rawget(value,"slots"))~="table" then return nil end
    local total,visited=0,0
    for _,slot in next,value.slots do
        visited+=1;if visited>5000 or type(slot)~="table" then return nil end
        local item,n=rawget(slot,1),rawget(slot,2)
        if not integer(item) or item<0 or not integer(n) or n<0 then return nil end
        if item==id then total+=n end
    end
    return total
end
local function cacheLoopSnapshot(reply)
    local a=autoLoop
    if not a then return true end
    local blocks,seeds=measure(reply,a.block),measure(reply,a.seed)
    if blocks==nil or seeds==nil then return false end
    if a.blocks~=blocks or a.seeds~=seeds then a.progressAt=os.clock() end
    a.blocks,a.seeds=blocks,seeds;a.nextCheck=os.clock()+3
    return true
end
local function finishPickup(p,message)
    if pending~=p then return end
    pending=nil;nextCollect=os.clock()+.05
    nextAction=math.max(nextAction,os.clock()+(p.binding.netCall and .02 or .15))
    if autoLoop and p.metrics.inventory then
        local entry=p.metrics.inventory
        if not entry.afterJob or not cacheLoopSnapshot(entry.afterJob.reply) then autoLoop.nextCheck=0 end
    end
    if autoLoop and autoLoop.capacityDrops then
        for _,item in ipairs(p.results) do
            if not worldDrop(p.binding,item.record) then autoLoop.capacityDrops[item.uid]=nil end
        end
    end
    log(message);report(true)
end
local function shortReply(reply)
    if not reply then return "?" end
