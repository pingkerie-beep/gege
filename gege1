            f.returnedStep={key=f.target and f.target.key,count=count}
            f.speed=math.max(2.5,(f.speed or CONFIG.speed)*.8)
        end
        local retryDelay=returned and math.min(15,1+count*2) or 2
        if node and node.fromKey~=nil and node.toKey~=nil and node.fromKey~=node.toKey then
            local edge=tostring(node.fromKey)..">"..tostring(node.toKey)
