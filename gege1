            farmNote="JEDA: verifikasi setor menunggu world "..tostring(a.deposit.world or a.world).."; tidak mengirim setor ulang.";return
        end
        local def,seed=rawget(b.itemDB,a.block),rawget(b.itemDB,a.seed)
