    module=compatibility.module(b,get,module,{},2)
    local permission=areaModule and ownedArity(mayBuild,areaModule,3)
    local putMarkers=pv and hasConstants(put,{"count","backpackNow","remove","object_spawn2","spawn"})
    -- The v1012 display closure calls state.call and captures its history in slot 4.
    local history=pv and pv[b.netCall and 4 or 5]
