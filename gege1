                or autoLoop.waitingWorld and ("Waiting for farm world "..tostring(autoLoop.pinnedWorld)..". No actions run in another world.")
                or autoLoop.paused and (autoLoop.paused.status or "Rechecking the character, inventory, and farm position.")
                or farm and farm.stepRejected and "Movement was returned by the game. Retrying the route automatically after a short pause."
                or farm and farm.recoveryTarget and "Repositioning on a nearby supported tile, then resuming the original target."
                or farm and farm.action and "Waiting for action confirmation."
