        if not count then halt("Inventory tidak terbaca; PNB dihentikan.");return end
        if count<=0 then
            running=false;runButton.Text="PNB: OFF";log("Item PNB habis; kolek tetap berjalan jika ON.");return
        end
        if b.netCall then
            local native=autoLoop and autoLoop.native or settings.native
            local current=farmTile(native,anchor.tx,anchor.ty,settings.layer)
            if current==settings.id then
                cycle={id=settings.id,layer=settings.layer,x=anchor.tx,y=anchor.ty,hits=0}
                return
            end
            local ok,allowed=pcall(native.canPlace,b.itemDB[settings.id],anchor.tx,anchor.ty)
            if not ok then halt("Pemeriksaan petak native gagal.");return end
            if allowed~=true then
                settings.blockedAt=settings.blockedAt or os.clock()
                if os.clock()-settings.blockedAt>=CONFIG.rpcTimeout then
                    if autoLoop then autoLoop.relocateHome=true end
                    halt("The PNB tile stayed unavailable. Selecting another permitted tile.")
                end
                return
            end
            settings.blockedAt=nil
        end
        cycle={id=settings.id,layer=settings.layer,x=anchor.tx,y=anchor.ty,hits=0}
        local ok,err=action(true,cycle,b)
        if not ok then halt("Place gagal: "..tostring(err));return end
    else
        local ok,err,broken=action(false,cycle,b,cycle.hits+1>=settings.hits,settings.hits)
        if not ok then halt("Break gagal: "..tostring(err));return end
        cycle.hits+=1
