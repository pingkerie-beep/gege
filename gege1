    collecting=true;collectFilter,filterText=nil,"ALL";filterInput.Text="ALL"
    runButton.Text="PNB: OFF";collectButton.Text="Kolek: ON";farmButton.Text="Auto Farm: ON"
    loopStage(a,resume)
    if resume=="PNB" and a.relocateHome then a.blockedHome=true end
