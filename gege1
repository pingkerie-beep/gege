        end
        p.binding,p.inventoryWorld=b,world;p.retryAt=0
        if not p.job then
            p.inventoryReady=nil
            local remote=rpcFor(b,"GetInventory")
            if not remote then p.status="Waiting for server inventory access.";farmNote=p.status;return end
            p.status="Reading backpack inventory before resuming farm actions.";farmNote=p.status
