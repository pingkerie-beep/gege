            if autoLoop then autoLoop.relocateHome=true end
            halt("The block did not break after confirmed native hits. Checking another PNB tile.");return
        end
    end
    nextAction=os.clock()+(b.netCall and settings.interval or cycle and settings.interval or math.max(.3,settings.interval))
end
