        settings={id=a.block,hits=a.hits,interval=a.interval,layer=a.layer}
        running=true;nextAction=os.clock();runButton.Text="PNB: ON"
    elseif a.stage=="TANAM" then
        f.mode="plant"
        if a.seeds==0 or f.lastScan and not f.scan and f.lastScan.actionable==0 then loopStage(a,"PANEN") end
    elseif a.stage=="PANEN" then
        f.mode="harvest"
        -- Finish the harvest pass before returning to PNB, even when the first
        -- harvested tree already supplied blocks. Each tree still awaits its ACK.
        if f.lastScan and not f.scan and f.lastScan.ripe==0 then
