                a.prepare=true;a.prep=nil
                log(string.format("PNB target changed to %s (%d,%d); overhead or previous tile unavailable.",a.layer,home.tx,home.ty))
            end
            a.home=home;t=home
        elseif t.ty<0 or t.ty>=a.native.height or math.abs(x-t.x)<=.25 and math.abs(y-t.y)<=.18 then
            replacePNBHome(a,x,y);return
        end
        local current=farmTile(a.native,t.tx,t.ty,a.layer)
        if current~=0 and current~=a.block then replacePNBHome(a,x,y);return end
        local def=a.native.b.itemDB[a.block]
        local ok,allowed=pcall(a.native.canPlace,def,t.tx,t.ty)
        if current==a.block then
            local reached,radius=pcall(a.native.rangeFn or a.native.buildRange)
