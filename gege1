        farmVelocity(n,0)
        m.landingSince=m.landingSince or os.clock()
        if os.clock()-m.landingSince>3 then failed("no support beneath character") end
        farmNote="Waiting for the character to stand on a block or platform."
        return
    end
    m.landingSince=nil
    if node.kind~="walk" and node.kind~="start" then
        if s.grounded~=true then return end
        local sourceX,sourceY=node.fromKey%n.width,math.floor(node.fromKey/n.width)
        if math.abs(node.x-sourceX)>3 or node.y-sourceY>8 or sourceY-node.y>3 then failed("step exceeds the supported span");return end
        if math.abs(x-(sourceX+.5))>.18 or math.abs(y-(sourceY+.999))>.18 then
            failed("actual source no longer matches the planned support");return
        end
        if farmBoxHits(n,gx,gy) or not farmStanding(n,gx,gy) then failed("next support is unavailable");return end
        local points=farmFlightPath(n,x,y,gx,gy)
        if not points then failed("no clear route around the solid edge");return end
        m.transfer={x=x,y=y,points=points,index=1,at=os.clock(),progressX=x,progressY=y,progressAt=os.clock()}
        traceMotion(string.format("EDGE TRANSFER (%d,%d) -> (%d,%d); no jump, existing terrain",sourceX,sourceY,node.x,node.y))
        return
    end
    local dx,dy=gx-x,gy-y
    if math.abs(dx)<=.025 and math.abs(dy)<=.06 then m.index+=1;m.step=nil;return end
    if math.abs(dy)>.18 then failed("walking support height changed");return end
    local distance=math.abs(dx)
    m.step=m.step or {best=distance,at=os.clock()}
    if distance<m.step.best-.05 then m.step.best=distance;m.step.at=os.clock() end
    if os.clock()-m.step.at>1.5 then failed("supported move made no progress");return end
    local stride=math.min(distance,math.min(f.speed or CONFIG.speed,CONFIG.speed)*math.max(0,math.min(dt,elapsed,CONFIG.frameLimit)))
    if stride<=0 then return end
    local nx=x+(dx<0 and -stride or stride)
    for i=1,5 do
        local cx=x+(nx-x)*i/5
        if farmBoxHits(n,cx,gy) or not farmStanding(n,cx,gy) then failed("walking edge lost its support");return end
    end
    local moved,why=farmWritePosition(n,nx,gy)
    if not moved then halt(why);return end
    m.x,m.y=nx,gy
    if os.clock()>=m.nextSend then
        local sent,why=farmPublish(f,m);if not sent then halt(why) end
    end
end
local function farmMove(dt)
    local f=farm
    if autoLoop and autoLoop.paused then return end
    if not f or f.preview or f.correction or not f.motion or pending or Input:GetFocusedTextBox() then return end
    local m,n=f.motion,f.native
    local x,y,world=livePosition(n.b)
    if not x or world~=f.world or rawget(n.b.state,"respawnedAt")~=f.respawn then halt("World/respawn farm berubah.");return end
    if os.clock()-m.at>CONFIG.timeout then halt("Batas waktu menuju lahan tercapai.");return end
    if m.supported then farmPlatformMove(f,m,dt,x,y);return end
    local elapsed=math.max(0,os.clock()-(m.lastStep or os.clock()));m.lastStep=os.clock()
    local node=m.route[m.index]
    local drifted=math.abs(x-m.x)>1 or math.abs(y-m.y)>1
        or not node and (math.abs(x-m.destX)>.18 or math.abs(y-m.destY)>.18)
    if drifted then
        traceMotion(string.format("REPLAN local reset: actual %.2f,%.2f planned %.2f,%.2f",x,y,m.x,m.y))
        if farmDeferRoute(f,"local position reset") then return end
        if m.replans>=CONFIG.maxReplans then halt("Rute farm terus dikembalikan ke posisi awal.");return end
        local replanned=farmPlan(f,f.target,x,y)
        if replanned then replanned.replans=m.replans+1;f.motion=replanned
        else
            f.motion=nil;f.blockedOrder=f.target;f.routeRetryAt=os.clock()+3
        end
        return
    end
    if not node and math.abs(m.x-m.destX)<.00001 and math.abs(m.y-m.destY)<.00001 then
        traceMotion(string.format("ARRIVED %s (%d,%d) posisi %.3f,%.3f",f.target.kind,f.target.x,f.target.y,x,y))
        if f.motionFailures then f.motionFailures[f.target.key]=nil end
        f.motion=nil;f.arrived=os.clock();farmNote="Sampai lahan; memeriksa kembali sebelum aksi.";return
    end
    local gx,gy=node and node.x+.5 or m.destX,node and node.y+.999 or m.destY
    local dx,dy=gx-m.x,gy-m.y;local distance=math.sqrt(dx*dx+dy*dy)
    if distance<.00001 then if node then m.index+=1 end;return end
    local stride=math.min(distance,math.min(f.speed or CONFIG.speed,CONFIG.speed)*math.max(0,math.min(dt,elapsed,CONFIG.frameLimit)))
    if stride<=0 then return end
    local nx,ny=m.x+dx/distance*stride,m.y+dy/distance*stride
    local ok,blocked=pcall(function()
        for i=1,5 do
            local cx,cy=x+(nx-x)*i/5,y+(ny-y)*i/5
            if farmBoxHits(n,cx,cy) then return true end
        end
        return false
    end)
    if not ok then halt("Collision farm gagal dibaca.");return end
    if blocked then
        traceMotion(string.format("REPLAN blocked=%s aktual %.2f,%.2f rute %.2f,%.2f",tostring(blocked),x,y,m.x,m.y))
        if farmDeferRoute(f,blocked and "native collision" or "local position reset") then return end
        local attempts=m.replans+1
        if attempts>CONFIG.maxReplans then halt("Rute farm terus terhalang.");return end
        local replanned=farmPlan(f,f.target,x,y)
        if not replanned then
            f.motion=nil;f.blockedOrder=f.target;f.routeRetryAt=os.clock()+3
            farmNote="The first eligible tile is blocked; waiting for a supported route.";return
        end
        replanned.replans=attempts;f.motion=replanned;return
    end
    local moved,err=farmWritePosition(n,nx,ny)
    if not moved then halt("Gerak farm gagal: "..tostring(err));return end
    if farm~=f or f.motion~=m or f.correction then return end
    m.x,m.y=nx,ny
    if os.clock()>=m.nextSend then
        local sent,why=farmPublish(f,m);if not sent then halt(why);return end
    end
    if farm~=f or f.motion~=m or f.correction then return end
    if node and stride>=distance then m.index+=1 end
    farmNote=string.format("Farm menuju %s (%d,%d), rute %d/%d",f.target.kind,f.target.x,f.target.y,math.min(m.index,#m.route),#m.route)
end
local function farmActionVisible(f,a)
    local n=f.native
    local record=rawget(n.trees,a.y*n.width+a.x)
    local tile=farmTile(n,a.x,a.y)
    if a.kind=="plant" then
        return tile==f.seed and type(record)=="table" and type(rawget(record,"p"))=="number"
    end
    return tile==0 and record==nil
end
local function farmTick()
    local f=farm
    if not f or pending or f.motion then return end
    if autoLoop and autoLoop.paused then return end
    if autoLoop and autoLoop.stage~="TANAM" and autoLoop.stage~="PANEN" and autoLoop.stage~="TUNGGU"
        and not f.action and not f.correction then return end
    if autoLoop and (autoLoop.job or autoLoop.deposit) then return end
    local n=f.native
    local x,y,world=livePosition(n.b)
    if not x or world~=f.world then halt("World/posisi farm berubah.");return end
    if f.action then
        local a=f.action
        if a.inventoryReply and not f.job then
            f.job={done=true,reply=a.inventoryReply};a.inventoryReply=nil
        end
        local now=os.clock()
        local age=now-a.at
        local ready=a.ack or age>=(n.b.netCall and .15 or 2)
            or n.b.netCall and age>=.06 and (a.kind=="plant" or a.dropAck) and farmActionVisible(f,a)
        if not f.job and now>=(a.nextVerify or 0) and ready then
            local remote=rpcFor(n.b,"GetInventory")
            if not remote then halt("GetInventory untuk verifikasi farm tidak tersedia.");return end
            f.job=request(f,remote)
        elseif f.job then
            if not f.job.done then
                if os.clock()-f.job.started>=CONFIG.rpcTimeout then halt("Verifikasi inventory farm belum dijawab.") end
                return
            end
            local count=measure(f.job.reply,f.seed)
            local synced,note=syncInventory(n.b,f.job.reply)
            if count==nil or not synced then
                if n.b.netCall and os.clock()-a.at<CONFIG.rpcTimeout then
                    if not a.replyLogged then
                        a.replyLogged=true
                        local snapshot=f.job.reply and f.job.reply[2]
                        log(string.format("FARM %s snapshot pending: reply=%s argc=%s capacity=%s slots=%s",a.kind,
                            shortReply(f.job.reply),tostring(f.job.reply and f.job.reply.n),
                            tostring(type(snapshot)=="table" and rawget(snapshot,"capacity")),
                            type(type(snapshot)=="table" and rawget(snapshot,"slots"))))
                    end
                    f.job=nil;a.nextVerify=os.clock()+.25
                    farmNote="Menunggu snapshot inventory server untuk aksi "..a.kind.." yang sama.";return
                end
                halt("Inventory farm belum terverifikasi: "..tostring(note));return
            end
            local confirmed=a.ack
            if not confirmed and n.b.netCall and a.kind=="plant" and count==a.before-1 then
                -- Native plant updates the tile locally. The tree record is populated separately by the game.
                confirmed=farmActionVisible(f,a)
            end
            if not confirmed and n.b.netCall and a.kind=="harvest" then
                local blocks=measure(f.job.reply,f.seed-1)
                local credit=a.dropAck==true or count>a.before
                    or blocks and a.beforeBlocks and blocks>a.beforeBlocks
                confirmed=credit and farmActionVisible(f,a)
            end
            if not confirmed and n.b.netCall and os.clock()-a.at<CONFIG.rpcTimeout then
                f.job=nil;a.nextVerify=os.clock()+.15;return
            end
            if not confirmed then halt("Aksi "..a.kind.." belum dikonfirmasi server; farm dihentikan.");return end
            if not cacheLoopSnapshot(f.job.reply) then halt("Stok siklus dari verifikasi pohon belum valid.");return end
            if a.kind=="plant" then f.planted+=1 else f.harvested+=1 end
            log(string.format("FARM %s dikonfirmasi server (%d,%d), Seed ID %d, backpack %d -> %d, %.2fs. %s",
                a.kind,a.x,a.y,f.seed,a.before,count,os.clock()-a.at,note))
            if f.motionFailures then f.motionFailures[a.y*n.width+a.x]=nil end
            f.returnedStep=nil;f.recoveryTarget=nil;f.upwardRetryTarget=nil
            f.orderCursor=a.y*n.width+a.x
            f.blockedOrder=nil;f.routeRetryAt=nil
            f.job,f.action,f.target=nil,nil,nil;f.scan=nil;f.nextScan=os.clock()
            f.lastScan=nil
            f.resumeAt=os.clock()+(n.b.netCall and .03 or .35);nextCollect=0
        end
        return
    end
    if f.correction then
        local c=f.correction
        if os.clock()-c.at>8 then halt("Posisi belum stabil setelah perpindahan server; farm dihentikan.");return end
        if math.abs(x-c.x)>.15 or math.abs(y-c.y)>.15 then c.x,c.y,c.stableAt=x,y,os.clock() end
        farmNote="Server mengubah posisi; menunggu posisi stabil dan inventory server."
        if os.clock()-c.stableAt<1 or (lease.outstanding or 0)>0 then return end
        if not c.job then
            local remote=rpcFor(n.b,"GetInventory")
            if not remote then halt("GetInventory pemulihan farm tidak tersedia.");return end
            c.job=request(c,remote);return
        end
        if not c.job.done then return end
        local synced,note=syncInventory(n.b,c.job.reply)
        if not synced then halt("Inventory setelah perpindahan belum sesuai: "..tostring(note));return end
        f.correction=nil;f.motion,f.target,f.scan=nil,nil,nil;f.pathSearch=nil;f.candidates={};f.nextScan=0
        f.stepRejected=nil;f.recoveryTarget=nil
        if autoLoop then autoLoop.nextCheck=0 end
        f.respawn=rawget(n.b.state,"respawnedAt")
        log("Farm lanjut dari posisi server; memindai ulang pohon SIAP dan tumbuh.");report(true);return
    end
    if (lease.outstanding or 0)>0 or os.clock()<(f.resumeAt or 0) then return end
    if f.recoveryTarget and not f.target then
        f.target=f.recoveryTarget;f.recoveryTarget=nil;f.pathSearch=nil
    end
    if f.stepRejected then
        local rejected=f.stepRejected
        if math.abs(x-rejected.x)<=.5 and math.abs(y-rejected.y)<=.5 and os.clock()<(rejected.retryAt or 0) then
            farmNote="Movement recovery is cooling down before retrying the same farm tile."
            return
        end
        f.stepRejected=nil;f.routeRetryAt=nil;f.pathSearch=nil
        -- Repeated returns at one stance get a short supported side step, like
        -- a manual nudge. Keep the original farm tile and its row order intact.
        if rejected.count and rejected.count>=2 and f.target and not f.recoveryTarget then
            for _,offset in ipairs({-1,1}) do
                local t={x=math.floor(x)+offset,y=math.floor(y-.001),key=-1,kind="recovery"}
                if farmStanding(n,t.x+.5,t.y+.999)
                    and farmClearFlightSegment(n,x,y,t.x+.5,t.y+.999) then
                    local route=farmPlan(f,t,x,y)
                    if route then
                        f.recoveryTarget=f.target;f.target,f.motion=t,route
                        farmNote="Moving one supported tile to recover the route.";return
                    end
                    f.pathSearch=nil
                end
            end
        end
    end
    if n.glide and not farmStanding(n,x,y) then
        farmVelocity(n,0)
        farmNote="Waiting for a block or platform beneath the character before selecting a route."
        return
    end
    if f.target then
        if f.target.kind=="recovery" then
            f.target=f.recoveryTarget;f.recoveryTarget=nil;f.pathSearch=nil
            f.blockedOrder=nil;f.routeRetryAt=nil;f.arrived=0
            farmNote="Resuming the original farm tile after repositioning.";return
        end
        if f.routeRetryAt and os.clock()<f.routeRetryAt then
            farmNote=string.format("Waiting to reach the first eligible tile (%d,%d); later tiles stay queued.",f.target.x,f.target.y)
            return
        end
        if os.clock()-(f.arrived or 0)<(n.b.netCall and .04 or .2) then return end
        local t=f.target
        local kind,data=farmEligible(f,t.x,t.y)
        if kind~=t.kind then f.target=nil;f.pathSearch=nil;f.blockedOrder=nil;f.routeRetryAt=nil;f.candidates={};return end
        if math.abs(x-(t.x+.5))>.18 or math.abs(y-(t.y+.999))>.18 then
            local route=farmPlan(f,t,x,y)
            if route then f.motion=route
            elseif not f.pathSearch then f.blockedOrder=t;f.routeRetryAt=os.clock()+2 end
            return
        end
        if kind=="plant" then
            local good,allowed=pcall(n.canPlace,n.b.itemDB[f.seed],t.x,t.y)
            if not good then halt("Pemeriksaan lahan native gagal.");return end
            if allowed~=true then
                f.orderCursor=t.key;f.target=nil;f.blockedOrder=nil;f.routeRetryAt=nil
                farmNote="The game rejected planting on this tile; checking the next eligible tile.";return
            end
            if guardPNBDrops(n.b,t.x,t.y) then return end
        else
            log(string.format("HARVEST READY (%d,%d) SeedID=%d serverNow=%.3f readyAt=%.3f nativeReady=true",
                t.x,t.y,f.seed,data.now,data.readyAt))
        end
        local before=inventoryNumber(n.b,"count",f.seed)
        if before==nil then halt("Inventory seed tidak terbaca.");return end
        f.action={kind=kind,x=t.x,y=t.y,at=os.clock(),before=before,
            beforeBlocks=inventoryNumber(n.b,"count",f.seed-1),ack=false}
        local good,err
        if kind=="plant" then good,err=pcall(n.plant,f.seed,t.x,t.y)
        else good,err=pcall(n.hit,t.x,t.y) end
        if not good then halt("Aksi farm native gagal: "..tostring(err));return end
        if farm~=f then return end
        farmNote="Menunggu konfirmasi server: "..kind.." ("..t.x..","..t.y..").";return
    end
    if f.scan or not f.candidates or #f.candidates==0 and os.clock()>=f.nextScan then farmScanStep(f);return end
    if f.preview then return end
    -- The scan page already follows top-to-bottom, left-to-right order.
    for _=1,(n.glide and 1 or 8) do
        local t=table.remove(f.candidates,1)
        if not t then break end
        if farmEligible(f,t.x,t.y)==t.kind then
            f.target=t
            local close=math.abs(t.x+.5-x)<=.18 and math.abs(t.y+.999-y)<=.18
            if close then f.target=t;f.arrived=os.clock()-.2;farmNote="Target dalam jangkauan; memeriksa aksi tanpa perpindahan.";return end
            local movement=farmPlan(f,t,x,y)
            if movement then f.target,f.motion=t,movement;return end
            if not f.pathSearch then f.blockedOrder=t;f.routeRetryAt=os.clock()+2 end
            return
        end
    end
end
local function farmServerMoved()
