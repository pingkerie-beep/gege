            for row=math.ceil(math.min(y1,y2)-.5),math.floor(math.max(y1,y2)-.5) do
                if checkpoint and checkpoint()==false then return false,"budget" end
                local hit=column[row]
                if hit==nil then hit=farmBoxHits(n,x1,row+.5);column[row]=hit end
                if hit then segments[key]=false;return false,"solid" end
            end
        end
        local clear,why=farmClearFlightSegment(n,x1,y1,x2,y2,checkpoint)
        if key and why~="budget" then segments[key]=clear end
        return clear,why
    end
    local clear,why=clearSegment(ax,ay,bx,by)
    if clear then return {{x=bx,y=by}} end
    if why=="budget" then return nil,why end
    local candidates,seen={},{}
    local function add(x)
        if x>=.3 and x<=n.width-.3 and not seen[x] then
            seen[x]=true;table.insert(candidates,x)
        end
    end
    add(ax);add(bx)
    for _,base in ipairs({math.floor(ax),math.floor(bx)}) do
        for offset=0,3 do
            add(base+.5-.85-offset);add(base+.5+.85+offset)
