local function completeDrop(p,after)
    -- A balance change alone can be someone else's/native pickup. Require both
    -- this RPC's positive accepted count and the authoritative balance snapshot.
    if not p.accepted or not after or after<p.before+p.accepted then return "" end
    if not p.binding.setDropCount then return " Penyelarasan drop native belum terikat." end
    local list=records(p.binding)
    if not list then return " Tabel drop berubah; tidak diubah." end
    local found,visited=false,0
    for _,r in next,list do
        visited+=1;if visited>CONFIG.scanLimit then return "" end
        if r==p.record then found=true;break end
    end
    if not found then return " Drop sudah diperbarui game." end
    if p.record.uid~=p.uid or p.record.id~=p.id then return " Identitas drop berubah; tidak diubah." end
    local remaining=p.sentN-p.accepted
    local n=rawget(p.record,"n")
    if n==remaining or integer(n) and n<remaining then return " Drop sudah diperbarui game." end
    -- Another DropAdded/DropTaken may have changed this record while the RPC ran.
    -- Only complete an unchanged record; never resurrect or overwrite merged drops.
    if n~=p.sentN then return " Jumlah drop berubah; tidak ditimpa." end
    local ok=pcall(p.binding.setDropCount,p.record,remaining)
    return ok and " Drop diselaraskan dari pickup terverifikasi." or " Penyelarasan drop gagal."
end
local function syncInventory(b,reply)
    local snapshot=reply and reply[1] and reply[2]
    if type(snapshot)~="table" or not integer(rawget(snapshot,"capacity")) or snapshot.capacity<=0
        or measure(reply,1)==nil then return false,"Snapshot inventory tidak valid." end
    local desired={}
    for _,slot in next,snapshot.slots do desired[slot[1]]=(desired[slot[1]] or 0)+slot[2] end
    local callbackOK,callbackError=false,nil
    if b.inventorySync then callbackOK,callbackError=pcall(b.inventorySync,snapshot.slots,snapshot.capacity) end
    local repaired=0
    for id,n in pairs(desired) do
        local current=inventoryNumber(b,"count",id)
        if current==nil then return false,"Jumlah backpack native tidak terbaca: "..id end
        if current~=n then
            if not b.inventoryAdd then
                return false,"Backpack belum sesuai server untuk ID "..id.."; "..tostring(callbackError or "metode native belum terikat")
            end
            local method=current<n and b.inventoryAdd or b.inventoryRemove
            local ok,err=pcall(method,b.inventory,id,math.abs(n-current))
            if not ok or inventoryNumber(b,"count",id)~=n then return false,"Sinkron ID "..id.." gagal: "..tostring(err) end
            repaired+=1
        end
    end
    return true,repaired>0 and ("Backpack diperbarui lewat metode native: "..repaired.." ID.")
        or callbackOK and "Backpack sesuai snapshot server." or "Jumlah backpack sudah sesuai server."
end
local function metricsReady(p,after)
    for _,entry in pairs(p.metrics) do
        local job=after and entry.afterJob or entry.beforeJob
        if not job.done then return false end
    end
    return true
end
local function timedOut(p)
    for _,entry in pairs(p.metrics) do
        for _,job in pairs({entry.beforeJob,entry.afterJob}) do
            if job and not job.done and os.clock()-job.started>=CONFIG.rpcTimeout then return true end
        end
    end
    for _,item in ipairs(p.active) do
        if not item.job.done and os.clock()-item.job.started>=CONFIG.rpcTimeout then return true end
    end
    return false
end
local function stopForCapacity(id)
    if autoLoop then
        if id==autoLoop.seed then autoLoop.nextCheck=0 end
        return
    end
    if farm and not farm.preview then stopFarm("Kapasitas Item ID "..id.." penuh; Auto Farm dihentikan.") end
    if running then
        running=false;cycle,anchor,settings=nil,nil,nil;runButton.Text="PNB: OFF"
        log("Kapasitas Item ID "..id.." penuh; PNB dihentikan agar drop tidak terus bertambah.")
    end
end
local function reserveAmount(p,item)
    local n=item.record.n
    if item.id==112 then return n end
    local room=inventoryNumber(p.binding,"room",item.id)
    if not room then return nil end
    local reserved=p.reserved[item.id] or 0
    room=math.max(0,room-reserved)
    if autoLoop and item.id==autoLoop.seed then
        room=math.min(room,math.max(0,200-(inventoryNumber(p.binding,"count",item.id) or 200)-reserved))
    end
    if room<=0 then stopForCapacity(item.id);return nil end
    if not p.existing[item.id] and not p.newKinds[item.id] then
        if p.newSlots>=p.freeSlots then stopForCapacity(item.id);return nil end
        p.newKinds[item.id]=true;p.newSlots+=1
    end
    n=math.min(n,room)
    p.reserved[item.id]=reserved+n
    return n
end
local function consumeReply(p,item)
    item.takeReply=shortReply(item.job.reply)
    local value=nil
    if item.job.reply[1] and item.job.reply.n==2 then value=item.job.reply[2] end
    if integer(value) and value>0 and value<=item.amount then
        item.accepted=value;p.accepted[item.id]=(p.accepted[item.id] or 0)+value
        p.acceptedDrops+=1
    elseif item.job.reply[1] and (value==0 or value==false) then
        denied[item.uid]={at=os.clock(),x=item.sentX,y=item.sentY,rx=item.record.x,ry=item.record.y,n=item.sentN,id=item.id}
    end
    if item.id~=112 then
        p.reserved[item.id]=math.max(0,(p.reserved[item.id] or 0)-item.amount+(item.accepted or 0))
        -- Reserve a slot for accepted/in-flight item types. Rejected new kinds
        -- release it once no request for that type still owns a reservation.
        if p.reserved[item.id]==0 and p.newKinds[item.id] then
            p.newKinds[item.id]=nil;p.newSlots=math.max(0,p.newSlots-1)
        end
    end
    retryAt[item.uid]=os.clock()+CONFIG.retrySeconds
    p.finished+=1;table.insert(p.results,item)
    log(string.format("#%d TakeDrop=%s | borongan %d/%d",item.uid,item.takeReply,p.finished,#p.queue))
end
local function updatePickup()
    local p=pending
    if not p then return end
    if p.generation~=generation then pending=nil;return end
    local _,_,world=livePosition(p.binding)
    if world~=p.world then halt("World/posisi berubah; pickup dibatalkan.");return end
    if timedOut(p) then
        halt("Server belum menjawab; PNB/kolek dihentikan. Tidak menumpuk RPC.");report(true);return
    end
    if p.phase=="before" then
        if not metricsReady(p,false) then return end
        for key,entry in pairs(p.metrics) do
            if measure(entry.beforeJob.reply,entry.id)==nil then
                if p.binding.netCall then
                    entry.retryStarted=entry.retryStarted or entry.beforeJob.started
                    if os.clock()-entry.retryStarted<CONFIG.rpcTimeout then
                        if os.clock()>=(entry.nextRetry or 0) then
                            entry.nextRetry=os.clock()+.25;entry.beforeJob=request(p,entry.remote)
                        end
                        return
                    end
                end
                halt("Saldo awal "..(key=="gems" and "GetGems" or "GetInventory").." belum terbaca: "..shortReply(entry.beforeJob.reply));report(true);return
            end
        end
        local invMetric=p.metrics.inventory
        if invMetric then
            local snapshot=invMetric.beforeJob.reply[2]
            local cap=rawget(snapshot,"capacity")
            if not integer(cap) or cap<=0 then halt("Kapasitas server tidak terbaca; PNB/kolek dihentikan.");report(true);return end
            local occupied=0
            for _,slot in next,snapshot.slots do
                if slot[2]>0 then occupied+=1;p.existing[slot[1]]=true end
            end
            p.freeSlots=math.max(0,cap-occupied)
            local synced,note=syncInventory(p.binding,invMetric.beforeJob.reply)
            log("Sinkron awal: "..note)
            if not synced then halt("Backpack belum tersinkron; PNB/kolek dihentikan. "..note);report(true);return end
        end
        p.phase="take";p.nextWave=os.clock()
    end
    if p.phase=="take" then
        for index=#p.active,1,-1 do
            local item=p.active[index]
            if item.job.done then consumeReply(p,item);table.remove(p.active,index) end
        end
        if os.clock()>=p.nextWave then
            local launched=0
            while p.index<=#p.queue and #p.active<CONFIG.parallel and launched<CONFIG.parallel do
                local item=p.queue[p.index];p.index+=1
                if present(item) and near(p.binding,item.record,p.range or collectRange) then
                    local amount=reserveAmount(p,item)
                    if pending~=p then return end
                    if amount and amount>0 then
                        local x,y=livePosition(p.binding)
                        item.sentN,item.amount,item.sentX,item.sentY=item.record.n,amount,x,y
                        local metric=p.metrics[item.id==112 and "gems" or "inventory"]
                        item.before=measure(metric.beforeJob.reply,item.id)
                        attempts+=1;launched+=1
                        log(string.format("SEND #%d ID %d jumlah %d | player %.3f,%.3f | drop %.3f,%.3f | borongan %d/%d",
                            item.uid,item.id,amount,x,y,item.record.x,item.record.y,p.index-1,#p.queue))
                        item.job=request(item,p.takeRemote,item.uid,amount)
                        table.insert(p.active,item)
                    else p.finished+=1 end
                else
                    p.finished+=1
                    log("#"..item.uid.." Drop berubah, pickup bawaan aktif, atau di luar radius; dilewati.")
                end
            end
            if launched>0 then p.nextWave=os.clock()+CONFIG.waveGap end
        end
        if p.index>#p.queue and #p.active==0 then p.phase="wait";p.verifyAt=os.clock()+CONFIG.settleSeconds end
    elseif p.phase=="wait" and os.clock()>=p.verifyAt then
        p.phase="after"
        for _,entry in pairs(p.metrics) do entry.afterJob=request(p,entry.remote) end
    elseif p.phase=="after" and metricsReady(p,true) then
        local verified,summary={},{}
        for key,entry in pairs(p.metrics) do
            if key=="gems" then
                local before,after=measure(entry.beforeJob.reply,112),measure(entry.afterJob.reply,112)
                verified[112]=after and after>=before+(p.accepted[112] or 0) and after or nil
                if after then
                    table.insert(summary,after>before and string.format("Saldo server ID 112 naik %d (%d -> %d)",after-before,before,after)
                        or string.format("Saldo server ID 112: %d -> %d; tidak ada kenaikan",before,after))
                    table.insert(summary,syncGems(p.binding,112,after))
                else table.insert(summary,"Saldo gems server belum terverifikasi") end
            else
                for id,total in pairs(p.accepted) do
                    if id~=112 then
                        local before,after=measure(entry.beforeJob.reply,id),measure(entry.afterJob.reply,id)
                        if after then
                            if after>=before+total then verified[id]=after end
                            table.insert(summary,string.format("Saldo server ID %d naik %d (%d -> %d)",id,after-before,before,after))
                        else table.insert(summary,"Saldo item server belum terverifikasi") end
                    end
                end
                if measure(entry.afterJob.reply,entry.id)~=nil then
                    local synced,note=syncInventory(p.binding,entry.afterJob.reply)
                    table.insert(summary,note)
                    if not synced then
                        collecting=false;collectButton.Text="Kolek: OFF"
                        if running then running=false;cycle,anchor,settings=nil,nil,nil;runButton.Text="PNB: OFF" end
                    end
                end
            end
        end
        -- A protective pickup must confirm every accepted item in the server
        -- balance before allowing another place/hit, even if its visual vanished.
        if p.protectCell then
            for id,n in pairs(p.accepted) do
                if n>0 and not verified[id] then
                    p.phase="wait";p.verifyAt=os.clock()+3
                    if pickupGate then pickupGate.reason="Waiting for server inventory confirmation." end
                    log("PNB pickup guard: waiting for verified server credit; no repeated TakeDrop.")
                    return
                end
            end
        end
        for _,item in ipairs(p.results) do
            local note=completeDrop(item,verified[item.id])
            if note~="" then log("#"..item.uid..note) end
            if autoLoop and (item.accepted or 0)>0 and verified[item.id] then autoLoop.progressAt=os.clock() end
        end
        if p.acceptedDrops==0 then table.insert(summary,"Pickup ini belum diterima; drop tetap dipertahankan") end
        finishPickup(p,string.format("Borongan selesai: %d/%d drop diterima. %s",p.acceptedDrops,#p.queue,table.concat(summary,". ")))
    end
end
local function startPickup(b,cell)
    if farm and farm.motion and (farm.motion.supportStep or farm.motion.transfer) then return end
    if pending or (lease.outstanding or 0)>0 then return end
    if autoLoop and (autoLoop.paused or autoLoop.job or autoLoop.deposit or autoLoop.stage=="SETOR") then return end
    if farm and not farm.preview and (farm.action or farm.job or farm.correction) then return end
    local other=rawget(env,"_GemTargetRPC_v1")
    if type(other)=="table" and (other.outstanding or 0)>0 then return end
    -- In the PNB cell, include seeds/items excluded by a manual filter and use
    -- the normal local pickup radius. Server distance validation is unchanged.
    local range,filter=collectRange,collectFilter
    if cell then range=math.max(range,CONFIG.range);filter=nil end
    local queue,full=choose(b,range,filter,cell)
    if full then stopForCapacity(full) end
    if autoLoop and autoLoop.paused then return end
    if cell and not collecting and not running then return end
    if not collecting and not cell then return end
    if #queue==0 then return end
    local take=rpcFor(b,"TakeDrop")
    if not take then
        collecting=false;collectButton.Text="Kolek: OFF";log("TakeDrop belum tersedia.");return
    end
    local _,_,world=livePosition(b)
    local protectCell=cell
    local target=running and anchor and {x=anchor.tx,y=anchor.ty}
        or autoLoop and autoLoop.stage=="PNB" and autoLoop.home and {x=autoLoop.home.tx,y=autoLoop.home.ty}
    if not protectCell and target then
        for _,item in ipairs(queue) do if inDropCell(item.record,target) then protectCell=target;break end end
    end
    local p={binding=b,queue=queue,world=world,generation=generation,phase="before",takeRemote=take,range=range,protectCell=protectCell,
        metrics={},active={},index=1,finished=0,results={},accepted={},acceptedDrops=0,
        reserved={},existing={},newKinds={},newSlots=0,freeSlots=0}
    for _,item in ipairs(queue) do
        local key=item.id==112 and "gems" or "inventory"
        if not p.metrics[key] then
            local remote=rpcFor(b,key=="gems" and "GetGems" or "GetInventory")
            if not remote then
                collecting=false;collectButton.Text="Kolek: OFF";log("GetGems/GetInventory belum tersedia.");return
            end
            p.metrics[key]={remote=remote,id=item.id}
        end
    end
    pending=p
    for _,entry in pairs(p.metrics) do entry.beforeJob=request(p,entry.remote) end
    log("Kolek borongan "..#queue.." drop; maksimal "..CONFIG.parallel.." aktif, seed didahulukan.")
end
local function guardPNBDrops(b,tx,ty)
    local list=records(b)
    local cell={x=tx,y=ty}
    local count,visited,complete,fullItem=0,0,list~=nil,nil
    for _,r in next,list or {} do
        visited+=1
        if visited>CONFIG.scanLimit then complete=false;break end
        if worldDrop(b,r) and inDropCell(r,cell) then
            count+=1
            local room=r.id~=112 and inventoryNumber(b,"room",r.id)
            if room==0 or autoLoop and r.id==autoLoop.block and room and room<math.min(r.n,32) then
                fullItem=fullItem or r
                if autoLoop and r.id==autoLoop.block then
                    autoLoop.capacityDrops=autoLoop.capacityDrops or {}
                    autoLoop.capacityDrops[r.uid]=math.min(r.n,32)
                end
            end
        end
    end
    if count==0 and complete then pickupGate=nil;return false end
    local _,_,world=livePosition(b)
    local reason=count>0 and "Collecting drops from the PNB tile before placing or breaking." or "Waiting for live drop data."
    if not pickupGate or pickupGate.x~=tx or pickupGate.y~=ty or pickupGate.world~=world then
        pickupGate={x=tx,y=ty,world=world}
        log(string.format("PNB pickup guard: holding tile (%d,%d); collect and verify its drops before place/break.",tx,ty))
    end
    pickupGate.count,pickupGate.reason=count,reason
    if autoLoop then
        autoLoop.progressAt=os.clock() -- Collection waits do not expire the PNB progress timer.
        if (inventoryNumber(b,"count",autoLoop.seed) or 0)>=200 then
            -- A half-finished block stays in place while the existing storage
            -- flow frees seed space. Keep its exact hit progress for the return.
            if autoLoop.stage=="PNB" then
                autoLoop.heldPNB=autoLoop.heldPNB or {cycle=cycle,anchor=anchor or {x=autoLoop.home.x,y=autoLoop.home.y,
                    tx=tx,ty=ty,world=world},settings=settings,prep=autoLoop.prep,prepare=autoLoop.prepare,world=world}
                cycle,anchor,settings=nil,nil,nil;running=false;runButton.Text="PNB: OFF"
                autoLoop.prep=nil;autoLoop.prepare=true
            elseif farm then farm.target=nil end
            autoLoop.nextCheck=0
            pickupGate.reason="Seed stack full. Preparing storage before resuming PNB."
            return true
        end
        if fullItem and autoLoop.stage=="PNB" then
            autoLoop.capacityDrops=autoLoop.capacityDrops or {}
            autoLoop.blockedHome={x=tx,y=ty}
            autoLoop.prep=nil;autoLoop.prepare=true
            cycle,anchor,settings=nil,nil,nil;running=false;runButton.Text="PNB: OFF"
            pickupGate.reason="Backpack full. Moving PNB to a clear tile to create pickup room."
            return true
        end
    end
    startPickup(b,cell)
    if not pending and count>0 then pickupGate.reason="PNB is waiting for the tile's drops to be collected. Check pickup range and backpack space." end
    return true
end
-- Four-neighbour A*: shortest route through unoccupied avatar-sized cells.
local function gridRoute(width, height, sx, sy, gx, gy, blocked)
    if sx < 0 or sy < 0 or sx >= width or sy >= height
        or gx < 0 or gy < 0 or gx >= width or gy >= height then return nil, "Koordinat di luar world." end
    if blocked(gx, gy) then return nil, "Kotak target tertutup blok." end
    local function id(x, y) return y * width + x end
    local start, goal = id(sx, sy), id(gx, gy)
    local heap, cost, parent, closed = {}, { [start] = 0 }, {}, {}
    local started, expanded = os.clock(), 0
    local function push(node)
        local i = #heap + 1
        while i > 1 do
            local up = math.floor(i / 2)
            if heap[up].f <= node.f then break end
            heap[i], i = heap[up], up
        end
        heap[i] = node
    end
    local function pop()
        local first, last = heap[1], table.remove(heap)
        if #heap > 0 then
            local i = 1
            while i * 2 <= #heap do
                local child = i * 2
                if child < #heap and heap[child + 1].f < heap[child].f then child += 1 end
                if heap[child].f >= last.f then break end
                heap[i], i = heap[child], child
            end
            heap[i] = last
        end
        return first
    end
    push({ key = start, x = sx, y = sy, f = math.abs(gx - sx) + math.abs(gy - sy) })
    local directions = { {1,0}, {-1,0}, {0,1}, {0,-1} }
    while #heap > 0 do
        local node = pop()
        if not closed[node.key] then
            if node.key == goal then
                local reverse, key = {}, goal
                repeat
                    table.insert(reverse, { x = key % width, y = math.floor(key / width) })
                    key = parent[key]
                until key == nil
                local route = {}
                for i = #reverse, 1, -1 do table.insert(route, reverse[i]) end
                return route
            end
            expanded += 1
            if expanded > CONFIG.pathNodeLimit or os.clock() - started > CONFIG.pathTimeLimit then
                return nil, "Batas pencarian rute tercapai; world terlalu rumit."
            end
            closed[node.key] = true
            for _, delta in ipairs(directions) do
                local x, y = node.x + delta[1], node.y + delta[2]
