        end
        if not ok then halt("Pemeriksaan petak PNB native gagal.");return end
        if allowed~=true then
            local stand={x=t.sx or math.floor(t.x),y=t.sy or math.floor(t.y-.001),key=0,kind="pnb"}
            if math.abs(x-t.x)<.1 and math.abs(y-t.y)<.1 then halt("Petak PNB ditolak canPlace/izin native.");return end
            local m,why=farmPlan(f,stand,x,y)
            if not m then
