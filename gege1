    if resume~="TANAM" and resume~="PANEN" and resume~="TUNGGU" and resume~="PNB" then
        if a.seeds>=200 then resume="CEK" -- Preserve the storage transaction gate before planting.
        elseif a.blocks>0 or a.prepare and farmTile(a.native,a.home.tx,a.home.ty,a.layer)==a.block then resume="PNB"
        elseif a.seeds>0 then resume="TANAM"
