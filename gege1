                    table.insert(reverse,record.edge);k=record.previous
                end
                local route={{x=sx,y=sy,kind="start",fromKey=start,toKey=start,duration=0,vx=0,jumpVy=0}}
                for i=#reverse,1,-1 do table.insert(route,reverse[i]) end
                return route
            end
            expanded+=1
            if expanded>CONFIG.pathNodeLimit then return nil,"Supported route search reached its node limit." end
            closed[current.key]=true
            local function consider(tx,ty,kind,supported)
                if not supported and not stance(tx,ty) then return end
                local target=key(tx,ty)
                if closed[target] or denied(current.key,target) then return end
                -- Every flight takes at least its straight-line travel time.
                -- Avoid resampling a body corridor when it cannot improve the
                -- route already recorded for this stance.
                if kind~="walk" and cost[target] then
                    local dx,dy=tx-current.x,ty-current.y
                    if cost[current.key]+math.sqrt(dx*dx+dy*dy)/5+.19>=cost[target] then return end
                end
                local edge
                if kind=="walk" then edge=walk(current.x,current.y,tx)
                else edge=arc(current.x,current.y,tx,ty,kind) end
                if not edge then return end
                local nextCost=cost[current.key]+edge.duration
                if cost[target] and nextCost>=cost[target] then return end
                cost[target]=nextCost;parent[target]={previous=current.key,edge=edge}
                push({key=target,x=tx,y=ty,f=nextCost+heuristic(tx,ty)})
            end
            consider(current.x-1,current.y,"walk")
            consider(current.x+1,current.y,"walk")
            for dy=-3,8 do
                local row=stanceRow(current.y+dy)
                if timedOut then return nil,"Supported route search reached its time limit." end
                if row then
                    for dx=-3,3 do
                        if row[current.x+dx] and (dx~=0 or dy~=0) and not (dy==0 and math.abs(dx)==1) then
                            -- Prefer supported walking on the same row.
                            -- Sample air routes only for real gaps or row changes.
                            local walking=dy==0
                            if walking then
                                local direction=dx<0 and -1 or 1
                                for step=1,math.abs(dx) do
                                    if not row[current.x+direction*step] then walking=false;break end
                                end
                            end
                            if not walking then consider(current.x+dx,current.y+dy,dy>0 and "drop" or "jump",true) end
                        end
                    end
                end
            end
        end
    end
    if timedOut or not withinBudget() then return nil,"Supported route search reached its time limit." end
    return nil,"No supported platform route reaches this target."
end

