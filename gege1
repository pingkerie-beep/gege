    local function normalizeFilter(text)
        if type(text)~="string" or #text>128 then return nil end
        text=text:upper():match("^%s*(.-)%s*$")
        if text=="" or text=="ALL" then return "ALL" end
        if text:find("[^%d,%s]") then return nil end
        local seen,count={},0
        for token in text:gmatch("%d+") do
            local id=tonumber(token)
            if not integer(id) or id<=0 then return nil end
            if not seen[id] then seen[id]=true;count+=1 end
        end
        return count>0 and count<=32 and text or nil
    end
