local function farmScanStep(f)
    if f.orderMode~=f.mode then
        f.orderMode=f.mode;f.orderCursor=nil;f.scan=nil;f.candidates={}
    end
    local s=f.scan
    if not s then s={index=0,candidates={},empty=0,ripe=0,growing=0,unknown=0,rows={}};f.scan=s end
    local n=f.native
    local x,y=livePosition(n.b)
    if not x then halt("Posisi farm tidak terbaca.");return end
    local at,visited=os.clock(),0
    while s.index<n.width*(n.height-1) and visited<1024 and os.clock()-at<.006 do
        local tx,ty=s.index%n.width,math.floor(s.index/n.width)
        s.index+=1;visited+=1
        local kind,data=farmEligible(f,tx,ty)
        local key=ty*n.width+tx
        if data then
            if data.status=="ready" then s.ripe+=1
            elseif data.status=="growing" then
                s.growing+=1
                if not s.nextReady or data.readyAt<s.nextReady then s.nextReady=data.readyAt end
            else s.unknown+=1 end
            if #s.rows<80 then
                table.insert(s.rows,string.format("(%d,%d) SeedID=%d %s nativeReady=%s p=%s grow=%s serverNow=%s readyAt=%s remaining=%s",
                    tx,ty,f.seed,data.status,tostring(data.nativeReady),tostring(data.planted),tostring(data.grow),
                    tostring(data.now),tostring(data.readyAt),tostring(data.remaining)))
            end
        end
        if kind then
            if kind=="plant" then s.empty+=1 end
            -- Grid keys increase left to right, then top to bottom. Keep a
            -- bounded page after this pass's cursor; newly ripe trees behind
            -- the cursor wait for the next pass instead of pulling us back.
            if (not f.orderCursor or key>f.orderCursor)
                and #s.candidates<64 then
                table.insert(s.candidates,{x=tx,y=ty,key=key,kind=kind})
            end
        end
    end
    if s.index<n.width*(n.height-1) then
        farmNote=string.format("Farm: memindai lahan %d%%",math.floor(s.index/(n.width*(n.height-1))*100));return
    end
    f.scan=nil;f.candidates=s.candidates;f.nextScan=os.clock()+1
    if #f.candidates==0 and f.orderCursor then
        -- Complete this pass before revisiting earlier rows, even when the
        -- previous scan page ended in the middle of a row.
        f.orderCursor=nil;f.nextScan=os.clock()
    end
    s.actionable=#s.candidates;f.lastScan=s
    local wait=s.nextReady and math.max(0,math.ceil(s.nextReady-(farmClock() or s.nextReady)))
    farmSummary=string.format("Scan terakhir: SIAP %d | tumbuh %d | tak terbaca %d%s",
        s.ripe,s.growing,s.unknown,wait and (" | siap lagi ~"..wait.."s") or "")
    if type(writefile)=="function" then
        pcall(writefile,"PNBRange_Trees.txt","PNB Range 1.9.2\nWorld "..f.world.." | Seed ID "..f.seed.." | mode "..f.mode
            .."\n"..farmSummary.."\n"..table.concat(s.rows,"\n"))
    end
    farmNote=string.format("Seed %d | kosong %d | matang %d | tumbuh %d | tanam %d / panen %d",
        f.seed,s.empty,s.ripe,s.growing,f.planted,f.harvested)
