end
local function replacePNBHome(a,x,y)
    local n=a.native
    if a.relocateHome then
        a.badPNBTargets=a.badPNBTargets or {}
        if a.home then a.badPNBTargets[a.home.ty*n.width+a.home.tx]=os.clock()+30 end
        a.relocateHome=nil;a.homeSearch=nil;farm.pathSearch=nil
    end
    local search=a.homeSearch
    if search and (search.native~=n or math.abs(search.x-x)>.35 or math.abs(search.y-y)>.35) then
        a.homeSearch=nil;farm.pathSearch=nil;search=nil
    end
    if not search then
        local drops=records(n.b)
        if not drops then halt("Data drop belum tersedia untuk memilih petak PNB baru.");return false end
        local occupied={}
        for _,record in next,drops do
            if worldDrop(n.b,record) then occupied[math.floor(record.y)*n.width+math.floor(record.x)]=true end
        end
        local localHome=localPNBHome(a,x,y,true)
        if localHome then
            a.home=localHome;farm.target,farm.motion=nil,nil
            a.prepare=true;a.prep=nil
            log(string.format("PNB target selected %s (%d,%d); character stays on its supported tile.",a.layer,localHome.tx,localHome.ty))
            return true
        end
        search={native=n,x=x,y=y,homes={},index=1,scanIndex=0,occupied=occupied};a.homeSearch=search
    end
    if search.scanIndex then
        local started,visited=os.clock(),0
        while search.scanIndex<n.width*(n.height-2) do
            local sx,sy=search.scanIndex%n.width,1+math.floor(search.scanIndex/n.width)
            search.scanIndex+=1;visited+=1
            if farmTile(n,sx,sy-1,a.layer)==0 and not n.solid(sx,sy) and not search.occupied[(sy-1)*n.width+sx]
                and (not a.badHomes or (a.badHomes[sy*n.width+sx] or 0)<=os.clock())
                and (not a.badPNBTargets or (a.badPNBTargets[(sy-1)*n.width+sx] or 0)<=os.clock()) then
                local below=farmTile(n,sx,sy+1)
                local support=below and rawget(n.b.itemDB,below)
                if type(support)=="table" and (rawget(support,"solid")==true or rawget(support,"platform")==true) then
                    local ok,allowed=pcall(a.display.mayBuild,rawget(n.b.state,"lock"),sx,sy-1)
                    if ok and allowed==true then
                        table.insert(search.homes,{x=sx+.5,y=sy+.999,sx=sx,sy=sy,tx=sx,ty=sy-1,d=(sx+.5-x)^2+(sy+.999-y)^2})
                        table.sort(search.homes,function(l,r) return l.d<r.d end)
                        if #search.homes>32 then table.remove(search.homes) end
                    end
                end
            end
            if visited>=256 or os.clock()-started>=.003 then
                farmNote="Scanning permitted PNB positions in small batches.";return false
            end
        end
        search.scanIndex=nil;search.occupied=nil
    end
    -- Keep a cooperative search on its current candidate. Trying the next
    -- candidate while it is still planning discarded all CPU work on slow devices.
    for _=1,2 do
        local home=search.homes[search.index]
        if not home then break end
        local t={x=home.sx,y=home.sy,key=0,kind="pnb"}
        local route,why=farmPlan(farm,t,x,y)
        if route then
            a.homeSearch=nil;a.home=home;farm.target,farm.motion=t,route
            a.prepare=true;a.prep=nil;a.progressAt=os.clock()
            log(string.format("Memindahkan PNB ke petak kosong tanpa drop %s (%d,%d).",a.layer,home.tx,home.ty))
            return true
        end
        if why=="planning" then
            farmNote="Planning a route away from the blocked PNB tile.";return false
        end
        search.index+=1
    end
    if search.homes[search.index] then farmNote="Checking the next permitted PNB position.";return false end
    a.homeSearch=nil
    halt("Tidak ditemukan petak PNB kosong yang diizinkan dan dapat dijangkau.");return false
end
local function startupBreak(a,x,y)
    local p,n=a.prep,a.native
    if guardPNBDrops(n.b,p.x,p.y) then p.at=os.clock();return end
    local current=farmTile(n,p.x,p.y,p.layer)
    if current==0 then
        a.prep=nil;a.prepare=false;a.nextCheck=0;nextCollect=0
        log(string.format("BREAK AWAL: hit native selesai (%d,%d), %d pukulan; memeriksa inventory server sebelum lanjut.",p.x,p.y,p.hits))
        return
    end
    if current~=a.block then halt("Petak break awal berubah menjadi item lain; aksi dihentikan.");return end
    -- Game.hit chooses FG first, then BG. Never hit another FG item to reach BG.
    if p.layer=="bg" and farmTile(n,p.x,p.y,"fg")~=0 then
        a.prep=nil;a.prepare=false
        replacePNBHome(a,x,y);return
    end
    local ok,radius=pcall(n.rangeFn or n.buildRange)
    local permitted,canBuild=pcall(a.display.mayBuild,rawget(n.b.state,"lock"),p.x,p.y)
    if not ok or not finite(radius) or radius<=0 or radius>20
        or math.abs(p.x+.5-x)>radius or math.abs(p.y+.5-(y-.475))>radius or not permitted or canBuild~=true then
        halt("Blok awal di luar jangkauan/izin pukul native.");return
    end
    if os.clock()-p.at>12 or p.hits>=50 then
        a.relocateHome=true
        halt("Break awal belum selesai setelah hit native; lihat log BREAK AWAL. Tidak mengulang tanpa batas.");return
    end
    if os.clock()<p.nextAt then return end
    local hit,why=pcall(n.hit,p.x,p.y) -- same two-coordinate call as Game.act
    if not hit then halt("Hit native untuk blok awal gagal: "..tostring(why));return end
    playPNBAnimation(n.b,false,p.x,p.y)
    p.hits+=1;p.nextAt=os.clock()+math.max(n.b.netCall and .05 or .2,a.interval)
    farmNote=string.format("BREAK AWAL %s (%d,%d), pukulan %d; belum menaruh blok baru.",p.layer,p.x,p.y,p.hits)
end
local function loopTick()
    local a,f=autoLoop,farm
    if not a or a.paused or not f or pending or f.action or f.job or f.correction or cycle then return end
    if not collecting then halt("Kolek tidak aktif; siklus dihentikan agar hasil farm tidak tertinggal.");return end
